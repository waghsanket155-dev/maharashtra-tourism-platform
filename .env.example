# ==============================================================
# Maharashtra Tourism Platform - Environment Variables Template
# Copy this file to '.env' and update the values for your environment.
# ==============================================================

# Application Port (Default: 8080)
PORT=8080

# MongoDB Connection String (Default: mongodb://127.0.0.1:27017/tourist)
MONGO_URI=mongodb://127.0.0.1:27017/tourist

# Express Session Secret
SESSION_SECRET=your_secure_random_session_secret_here

# Google Gemini API Key (Required for AI Trip Planning)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for End-to-End Automated Testing (Default: http://localhost:8080)
BASE_URL=http://localhost:8080
