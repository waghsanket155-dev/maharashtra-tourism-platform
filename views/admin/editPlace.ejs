<% layout("layout/boilerplate") %>

<style>
  .edit-place-container {
    max-width: 900px;
    margin: 30px auto 80px;
    padding: 0 15px;
  }

  .form-card {
    background: #ffffff;
    border-radius: 22px;
    border: 1px solid #e0eee7;
    padding: 2.25rem;
    box-shadow: 0 10px 30px rgba(18, 60, 43, 0.08);
  }

  .form-header-box {
    background: linear-gradient(135deg, #183c2c 0%, #198754 100%);
    color: white;
    padding: 1.75rem 2rem;
    border-radius: 18px;
    margin-bottom: 2rem;
  }
</style>

<div class="edit-place-container">

  <!-- HEADER -->
  <div class="form-header-box d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <div class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-2 fw-bold text-uppercase" style="letter-spacing: 0.5px;">
        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Destination
      </div>
      <h3 class="fw-bold mb-1"><%= place.name %></h3>
      <p class="mb-0 opacity-90 small">
        Update destination details, category, photos, and location coordinates.
      </p>
    </div>

    <a href="/places" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Places
    </a>
  </div>

  <!-- FORM -->
  <div class="form-card">
    <form action="/places/<%= place._id %>" method="POST" novalidate class="needs-validation">

      <!-- SECTION 1: BASIC INFO -->
      <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
        <i class="fa-solid fa-circle-info text-success me-2"></i> Basic Information
      </h5>

      <div class="row g-3 mb-4">
        <div class="col-md-7">
          <label for="name" class="form-label fw-bold small">Destination Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="name" name="name" required value="<%= place.name %>" placeholder="e.g. Ajanta Caves">
        </div>

        <div class="col-md-5">
          <label for="district" class="form-label fw-bold small">District <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="district" name="district" required value="<%= place.district %>" placeholder="e.g. Pune, Satara">
        </div>

        <div class="col-md-6">
          <label for="category" class="form-label fw-bold small">Category <span class="text-danger">*</span></label>
          <select class="form-select" id="category" name="category" required>
            <% const categories = ["Historical", "Religious", "Nature", "Wildlife", "Park / Garden", "Museum", "Beach", "Adventure", "Family", "Park / Family", "Leisure", "Trekking", "Wellness", "Cultural", "Hill Station"]; %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= place.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-6">
          <label for="rating" class="form-label fw-bold small">Rating (0 - 5)</label>
          <input type="number" step="0.1" min="0" max="5" class="form-control" id="rating" name="rating" value="<%= place.rating || '' %>" placeholder="e.g. 4.6">
        </div>

        <div class="col-12">
          <label for="description" class="form-label fw-bold small">Description <span class="text-danger">*</span></label>
          <textarea class="form-control" id="description" name="description" rows="4" required placeholder="Enter description..."><%= place.description %></textarea>
        </div>

        <div class="col-12">
          <label for="images" class="form-label fw-bold small">Image URL</label>
          <input type="url" class="form-control" id="images" name="images" value="<%= (place.images && place.images.length > 0) ? place.images[0] : '' %>" placeholder="https://example.com/photo.jpg">
          <div class="form-text small">Web URL of the destination image.</div>
        </div>
      </div>

      <!-- SECTION 2: LOCATION -->
      <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
        <i class="fa-solid fa-location-dot text-success me-2"></i> Location & Coordinates
      </h5>

      <div class="row g-3 mb-4">
        <div class="col-12">
          <label for="address" class="form-label fw-bold small">Address / Landmark</label>
          <input type="text" class="form-control" id="address" name="address" value="<%= place.location?.address || '' %>" placeholder="e.g. Mahabaleshwar, Satara, Maharashtra">
        </div>

        <div class="col-md-6">
          <label for="latitude" class="form-label fw-bold small">Latitude (°N)</label>
          <input type="number" step="any" min="-90" max="90" class="form-control font-monospace" id="latitude" name="latitude" value="<%= place.location?.latitude || place.latitude || '' %>" placeholder="e.g. 17.9237">
        </div>

        <div class="col-md-6">
          <label for="longitude" class="form-label fw-bold small">Longitude (°E)</label>
          <input type="number" step="any" min="-180" max="180" class="form-control font-monospace" id="longitude" name="longitude" value="<%= place.location?.longitude || place.longitude || '' %>" placeholder="e.g. 73.6586">
        </div>
      </div>

      <!-- SECTION 3: TIMINGS & FEES -->
      <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
        <i class="fa-solid fa-clock text-success me-2"></i> Visiting Timings & Entry Fee
      </h5>

      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <label for="bestTime" class="form-label fw-bold small">Best Time to Visit</label>
          <input type="text" class="form-control" id="bestTime" name="bestTime" value="<%= place.bestTime || '' %>" placeholder="e.g. October to March">
        </div>

        <div class="col-md-4">
          <label for="openingTime" class="form-label fw-bold small">Opening Time</label>
          <input type="text" class="form-control" id="openingTime" name="openingTime" value="<%= place.openingTime || '' %>" placeholder="e.g. 09:00 AM">
        </div>

        <div class="col-md-4">
          <label for="closingTime" class="form-label fw-bold small">Closing Time</label>
          <input type="text" class="form-control" id="closingTime" name="closingTime" value="<%= place.closingTime || '' %>" placeholder="e.g. 06:00 PM">
        </div>

        <div class="col-md-6">
          <label for="entryFeeIndian" class="form-label fw-bold small">Entry Fee - Indian Tourists (₹)</label>
          <input type="number" min="0" class="form-control" id="entryFeeIndian" name="entryFeeIndian" value="<%= place.entryFee?.indian || '' %>" placeholder="e.g. 50">
        </div>

        <div class="col-md-6">
          <label for="entryFeeForeign" class="form-label fw-bold small">Entry Fee - Foreign Tourists (₹)</label>
          <input type="number" min="0" class="form-control" id="entryFeeForeign" name="entryFeeForeign" value="<%= place.entryFee?.foreign || '' %>" placeholder="e.g. 500">
        </div>
      </div>

      <!-- SUBMIT -->
      <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <a href="/places" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-success fw-bold rounded-pill px-5 shadow-sm">
          <i class="fa-solid fa-save me-1"></i> Update Destination
        </button>
      </div>

    </form>
  </div>

</div>
