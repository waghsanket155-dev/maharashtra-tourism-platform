<% layout("layout/boilerplate") %>

<style>
  :root {
    --primary-green: #198754;
    --dark-green: #11643e;
    --light-green: #e8f6ef;
    --accent-green: #20c997;
    --card-shadow: 0 10px 30px rgba(18, 60, 43, 0.08);
  }

  .planner-hero {
    background: linear-gradient(135deg, #126b47 0%, #198754 50%, #20c997 100%);
    color: white;
    padding: 2.5rem 1.5rem;
    border-radius: 24px;
    margin-bottom: 2rem;
    box-shadow: 0 15px 35px rgba(25, 135, 84, 0.2);
    position: relative;
    overflow: hidden;
  }

  .planner-hero::after {
    content: "🧭";
    position: absolute;
    right: 25px;
    bottom: -15px;
    font-size: 110px;
    opacity: 0.18;
    pointer-events: none;
  }

  .section-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(25, 135, 84, 0.12);
    box-shadow: var(--card-shadow);
    padding: 1.75rem;
    margin-bottom: 2rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .section-title {
    color: #123c2b;
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid #eef6f2;
    padding-bottom: 0.75rem;
  }

  .section-title i {
    color: var(--primary-green);
  }

  /* Basket Destination Cards */
  .basket-card {
    border-radius: 16px;
    border: 1px solid #e2eee7;
    background: #fbfdfc;
    transition: all 0.3s ease;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .basket-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 22px rgba(25, 135, 84, 0.12);
    border-color: var(--primary-green);
  }

  .basket-img {
    height: 140px;
    object-fit: cover;
    width: 100%;
  }

  .basket-body {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Search & Filter section */
  .search-input-group .form-control {
    border-radius: 50px 0 0 50px;
    padding-left: 20px;
    border-color: #ced4da;
  }
  .search-input-group .btn {
    border-radius: 0 50px 50px 0;
    padding-right: 20px;
    padding-left: 20px;
  }

  .search-dest-card {
    border-radius: 16px;
    border: 1px solid #e8f0ec;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: all 0.25s ease;
  }

  .search-dest-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
  }

  .search-dest-img {
    height: 150px;
    object-fit: cover;
    width: 100%;
  }

  /* Day Builder Cards */
  .day-card {
    background: #ffffff;
    border: 2px solid #e0eee7;
    border-radius: 18px;
    margin-bottom: 1.5rem;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0,0,0,0.04);
    transition: border-color 0.3s ease;
  }

  .day-card:hover {
    border-color: var(--primary-green);
  }

  .day-header {
    background: linear-gradient(90deg, #f0f8f4 0%, #e8f6ef 100%);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #d8eade;
    flex-wrap: wrap;
    gap: 10px;
  }

  .day-badge {
    background: var(--primary-green);
    color: white;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 6px 14px;
    border-radius: 20px;
  }

  .activity-row {
    background: #fbfdfc;
    border: 1px solid #e7f0ec;
    border-radius: 14px;
    padding: 1.1rem;
    margin-bottom: 1rem;
    position: relative;
    transition: background 0.2s ease;
  }

  .activity-row:hover {
    background: #f5faf7;
  }

  .activity-index-badge {
    width: 28px;
    height: 28px;
    background: #198754;
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
  }

  /* Budget summary box */
  .budget-card {
    background: linear-gradient(145deg, #ffffff 0%, #f7fbf9 100%);
    border: 2px solid #cce8db;
    border-radius: 22px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
  }

  .budget-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px dashed #e0eee7;
    font-size: 0.95rem;
  }

  .budget-item.total-item {
    border-bottom: none;
    border-top: 2px solid #198754;
    margin-top: 0.5rem;
    padding-top: 1rem;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary-green);
  }

  .budget-remaining {
    padding: 12px;
    border-radius: 14px;
    margin-top: 12px;
    font-weight: 700;
    text-align: center;
  }

  .budget-remaining.within {
    background: #e8f6ef;
    color: #126b47;
    border: 1px solid #b8e6cf;
  }

  .budget-remaining.exceeded {
    background: #ffebee;
    color: #c62828;
    border: 1px solid #ffcdd2;
  }

  /* Form controls */
  .form-label {
    font-weight: 600;
    color: #244133;
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .form-control, .form-select {
    border-radius: 10px;
    border: 1px solid #d2e3da;
    padding: 0.55rem 0.85rem;
    font-size: 0.92rem;
  }

  .form-control:focus, .form-select:focus {
    border-color: #198754;
    box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
  }

  .btn-save-trip {
    background: linear-gradient(135deg, #198754 0%, #11643e 100%);
    color: white;
    font-weight: 800;
    font-size: 1.15rem;
    padding: 14px 32px;
    border-radius: 14px;
    border: none;
    box-shadow: 0 10px 25px rgba(25, 135, 84, 0.3);
    transition: all 0.3s ease;
  }

  .btn-save-trip:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(25, 135, 84, 0.4);
    color: white;
  }

  .sticky-budget {
    position: sticky;
    top: 85px;
  }

  @media (max-width: 991px) {
    .sticky-budget {
      position: static;
    }
  }
</style>

<div class="container py-4">

  <!-- ========================================== -->
  <!-- 1. HERO HEADER                             -->
  <!-- ========================================== -->
  <div class="planner-hero">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="fw-bold mb-2">
          <% if (typeof tripToEdit !== 'undefined' && tripToEdit) { %>
            ✏️ Edit Manual Trip: <%= tripToEdit.tripName || tripToEdit.title || "Maharashtra Trip" %>
          <% } else { %>
            🧭 Complete Manual Trip Planner
          <% } %>
        </h1>
        <p class="mb-0 opacity-90 fs-6">
          Take total control of your journey across Maharashtra. Select your favorite destinations, schedule custom day-by-day itineraries, manually record transit and tickets, and keep your budget in check.
        </p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/explore" class="btn btn-light text-success fw-bold me-2 px-3 py-2 shadow-sm rounded-pill">
          <i class="fa-solid fa-compass me-1"></i> Explore Places
        </a>
        <a href="/my-trips" class="btn btn-outline-light fw-bold px-3 py-2 rounded-pill">
          <i class="fa-solid fa-heart me-1"></i> My Trips
        </a>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 2. SELECTED DESTINATIONS (PLANNER BASKET)  -->
  <!-- ========================================== -->
  <div class="section-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
      <div class="section-title mb-0 border-0 p-0">
        <i class="fa-solid fa-clipboard-check"></i>
        <span>My Selected Trip Destinations</span>
        <span class="badge bg-success rounded-pill ms-2" id="basketCount">
          <%= plannerPlaces ? plannerPlaces.length : 0 %>
        </span>
      </div>
      <div>
        <a href="#destSearchSection" class="btn btn-sm btn-outline-success rounded-pill fw-semibold">
          <i class="fa-solid fa-magnifying-glass me-1"></i> Find More Destinations
        </a>
      </div>
    </div>

    <% if (!plannerPlaces || plannerPlaces.length === 0) { %>
      <div class="text-center py-4 px-3 bg-light rounded-4 border border-dashed border-success">
        <div class="fs-1 mb-2">📍</div>
        <h5 class="fw-bold text-dark">No Destinations in Your Planner Yet</h5>
        <p class="text-muted mb-3" style="max-width: 500px; margin: auto;">
          Browse Maharashtra's forts, beaches, caves, and hill stations below or on the Explore page, and click <strong>Add to Planner</strong> to begin designing your itinerary.
        </p>
        <a href="#destSearchSection" class="btn btn-success rounded-pill px-4 fw-bold">
          <i class="fa-solid fa-plus me-1"></i> Browse & Add Destinations Below
        </a>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" id="basketGrid">
        <% plannerPlaces.forEach(item => { 
            const p = item.destination_id;
            if (!p) return;
        %>
          <div class="col" id="basket-item-<%= p._id %>">
            <div class="basket-card shadow-sm">
              <img 
                src="<%= p.images?.[0] || '/image/placeholder.svg' %>" 
                alt="<%= p.name %>" 
                class="basket-img"
                loading="lazy"
                onerror="this.onerror=null;this.src='/image/placeholder.svg';"
              >
              <div class="basket-body">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem;">
                    <%= p.category %>
                  </span>
                  <small class="text-muted">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= p.district %>
                  </small>
                </div>
                <h6 class="fw-bold text-dark mb-1 text-truncate" title="<%= p.name %>">
                  <%= p.name %>
                </h6>
                <div class="small text-muted mb-2">
                  🎟️ <%= (p.entryFee && p.entryFee.indian !== null && p.entryFee.indian !== undefined) ? '₹' + p.entryFee.indian : 'Free / Not specified' %>
                </div>
                <div class="mt-auto d-flex gap-2">
                  <a href="/touristplaces/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-secondary flex-grow-1" title="View place details">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <form action="/m-planner/<%= p._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Remove this destination from your planner?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from planner">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- 3. SEARCH & ADD DESTINATIONS IN PLANNER    -->
  <!-- ========================================== -->
  <div class="section-card" id="destSearchSection">
    <div class="section-title">
      <i class="fa-solid fa-magnifying-glass-location"></i>
      <span>Browse & Add Destinations from Inside Planner</span>
    </div>

    <!-- Search Controls -->
    <div class="row g-2 mb-3">
      <div class="col-md-5">
        <div class="input-group search-input-group">
          <input 
            type="text" 
            id="plannerSearchInput" 
            class="form-control" 
            placeholder="Search by name, district, or keywords..."
          >
          <button class="btn btn-success" type="button" onclick="filterPlannerDestinations()">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <select id="categoryFilter" class="form-select" onchange="filterPlannerDestinations()">
          <option value="">All Categories</option>
          <% if (typeof categories !== 'undefined' && categories) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3 col-6">
        <select id="districtFilter" class="form-select" onchange="filterPlannerDestinations()">
          <option value="">All Districts</option>
          <% if (typeof districts !== 'undefined' && districts) { %>
            <% districts.forEach(dist => { %>
              <option value="<%= dist %>"><%= dist %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-1 d-grid">
        <button class="btn btn-outline-secondary" type="button" onclick="resetPlannerFilters()" title="Reset Filters">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
      </div>
    </div>

    <!-- Live Search Results Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" id="destResultsGrid" style="max-height: 480px; overflow-y: auto; padding: 4px;">
      <% 
        const addedIds = new Set((plannerPlaces || []).map(item => item.destination_id?._id?.toString()).filter(Boolean));
        if (typeof allDestinations !== 'undefined' && allDestinations) { 
          allDestinations.forEach(place => {
            const isAdded = addedIds.has(place._id.toString());
      %>
        <div 
          class="col dest-item" 
          data-name="<%= (place.name || '').toLowerCase() %>"
          data-district="<%= (place.district || '').toLowerCase() %>"
          data-category="<%= (place.category || '').toLowerCase() %>"
          data-desc="<%= (place.description || '').toLowerCase() %>"
        >
          <div class="search-dest-card">
            <img 
              src="<%= place.images?.[0] || '/image/placeholder.svg' %>" 
              alt="<%= place.name %>" 
              class="search-dest-img"
              loading="lazy"
              onerror="this.onerror=null;this.src='/image/placeholder.svg';"
            >
            <div class="p-3 d-flex flex-column flex-grow-1">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  <%= place.category %>
                </span>
                <small class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= place.district %></small>
              </div>
              <h6 class="fw-bold mb-1 text-dark"><%= place.name %></h6>
              <p class="text-muted small mb-2 text-truncate-2" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= place.description || 'Explore this Maharashtra gem.' %>
              </p>
              <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted fw-bold">
                  🎟️ <%= (place.entryFee && place.entryFee.indian !== null && place.entryFee.indian !== undefined) ? '₹' + place.entryFee.indian : 'Free' %>
                </small>
                <% if (isAdded) { %>
                  <span class="badge bg-secondary-subtle text-secondary border">
                    <i class="fa-solid fa-check me-1"></i>In Planner
                  </span>
                <% } else { %>
                  <form action="/m-planner/<%= place._id %>" method="POST" class="d-inline m-0">
                    <button type="submit" class="btn btn-sm btn-success px-2 py-1 fw-semibold">
                      <i class="fa-solid fa-plus me-1"></i>Add
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% })} %>
    </div>

    <!-- Empty state for search -->
    <div id="noDestMatch" class="text-center py-5 d-none">
      <i class="fa-solid fa-filter-circle-xmark fs-1 text-muted mb-2"></i>
      <h5 class="fw-bold text-secondary">No destinations match your search</h5>
      <p class="text-muted small">Try adjusting your keywords, district, or category filter.</p>
      <button class="btn btn-outline-success btn-sm rounded-pill" onclick="resetPlannerFilters()">Show All Destinations</button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 4. MAIN TRIP ITINERARY BUILDER & FORM      -->
  <!-- ========================================== -->
  <form 
    id="manualTripForm" 
    action="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? '/my-trips/' + tripToEdit._id + '?_method=PUT' : '/save-manual-trip' %>" 
    method="POST"
  >
    <div class="row">
      <!-- Left Column: Form Details & Itinerary Builder -->
      <div class="col-lg-8">
        
        <!-- TRIP BASIC DETAILS -->
        <div class="section-card">
          <div class="section-title">
            <i class="fa-solid fa-route"></i>
            <span>Trip Overview & Details</span>
          </div>

          <div class="row g-3">
            <!-- Trip Name -->
            <div class="col-md-7">
              <label for="tripName" class="form-label">
                Trip Name <span class="text-danger">*</span>
              </label>
              <input 
                type="text" 
                class="form-control" 
                id="tripName" 
                name="tripName" 
                placeholder="e.g., 4-Day Sahyadri Monsoon Heritage Tour" 
                value="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.tripName || tripToEdit.title) : '' %>"
                required
              >
            </div>

            <!-- Starting City -->
            <div class="col-md-5">
              <label for="startingCity" class="form-label">
                Starting City <span class="text-danger">*</span>
              </label>
              <input 
                type="text" 
                class="form-control" 
                id="startingCity" 
                name="startingCity" 
                placeholder="e.g., Pune, Mumbai, Nashik" 
                value="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.startingCity || '') : '' %>"
                required
              >
            </div>

            <!-- Travel Start Date -->
            <div class="col-md-4 col-sm-6">
              <label for="startDate" class="form-label">
                Travel Start Date <span class="text-danger">*</span>
              </label>
              <input 
                type="date" 
                class="form-control" 
                id="startDate" 
                name="startDate" 
                value="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.startDate || '') : '' %>"
                required
              >
            </div>

            <!-- Number of Travelers -->
            <div class="col-md-4 col-sm-6">
              <label for="travelers" class="form-label">
                Travelers <span class="text-danger">*</span>
              </label>
              <input 
                type="number" 
                class="form-control" 
                id="travelers" 
                name="travelers" 
                min="1" 
                max="50"
                value="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.travelers || 1) : 1 %>"
                required
              >
            </div>

            <!-- Planned Total Budget -->
            <div class="col-md-4 col-sm-12">
              <label for="plannedBudget" class="form-label">
                Planned Total Budget (₹)
              </label>
              <input 
                type="number" 
                class="form-control" 
                id="plannedBudget" 
                name="plannedBudget" 
                min="0" 
                step="50"
                placeholder="e.g., 10000"
                value="<%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.budget || 0) : '' %>"
                oninput="calculateBudgetSummary()"
              >
            </div>

            <!-- Personal Notes -->
            <div class="col-12">
              <label for="tripNotes" class="form-label">
                Personal Notes & Reminders (Optional)
              </label>
              <textarea 
                class="form-control" 
                id="tripNotes" 
                name="tripNotes" 
                rows="2" 
                placeholder="Pack trekking shoes, raincoats, carry ID proofs, camera batteries, etc."
              ><%= (typeof tripToEdit !== 'undefined' && tripToEdit) ? (tripToEdit.notes || '') : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- DAY-WISE MANUAL ITINERARY BUILDER -->
        <div class="section-card">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
            <div class="section-title mb-0 border-0 p-0">
              <i class="fa-solid fa-calendar-days"></i>
              <span>Day-Wise Manual Itinerary Builder</span>
            </div>
            <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-bold" onclick="addNewDay()">
              <i class="fa-solid fa-plus me-1"></i> Add Trip Day
            </button>
          </div>

          <p class="text-muted small mb-3">
            Add destinations, arrange visit timings, transport modes, and manual expense estimates for each day. You can add the same destination across different days if desired.
          </p>

          <!-- Day Cards Container -->
          <div id="daysContainer">
            <!-- Days will be dynamically rendered here via JavaScript -->
          </div>

          <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="button" class="btn btn-outline-success rounded-pill fw-bold" onclick="addNewDay()">
              <i class="fa-solid fa-calendar-plus me-1"></i> Add Another Day
            </button>
            <span class="text-muted small" id="totalDaysCountLabel">Total Days: 1</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Sticky Budget Summary & Submit Button -->
      <div class="col-lg-4">
        <div class="sticky-budget">
          <div class="budget-card mb-4">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
              <i class="fa-solid fa-wallet text-success"></i>
              <span>Manual Budget Summary</span>
            </h5>
            <p class="text-muted small mb-3">
              Automatically calculated from your manual expense inputs. Zero AI estimations.
            </p>

            <div class="budget-item">
              <span class="text-muted"><i class="fa-solid fa-car me-2 text-primary"></i>Transport Cost:</span>
              <strong id="summaryTransport">₹0</strong>
            </div>

            <div class="budget-item">
              <span class="text-muted"><i class="fa-solid fa-utensils me-2 text-warning"></i>Food & Dining:</span>
              <strong id="summaryFood">₹0</strong>
            </div>

            <div class="budget-item">
              <span class="text-muted"><i class="fa-solid fa-ticket me-2 text-info"></i>Entry Fees & Tickets:</span>
              <strong id="summaryEntry">₹0</strong>
            </div>

            <div class="budget-item">
              <span class="text-muted"><i class="fa-solid fa-receipt me-2 text-secondary"></i>Other Expenses:</span>
              <strong id="summaryOther">₹0</strong>
            </div>

            <div class="budget-item total-item">
              <span>Total Estimated Cost:</span>
              <span id="summaryTotal">₹0</span>
            </div>

            <div id="budgetRemainingBox" class="budget-remaining within mt-3">
              <div class="small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Remaining Budget</div>
              <div class="fs-5 fw-bold" id="remainingAmount">₹0</div>
              <div class="small" id="budgetStatusMsg">Within your planned budget</div>
            </div>
          </div>

          <!-- HIDDEN FIELD FOR COMPLETE ITINERARY PAYLOAD -->
          <input type="hidden" name="itineraryPayload" id="itineraryPayload">

          <!-- FINAL ACTION: SAVE COMPLETE TRIP BUTTON -->
          <div class="d-grid gap-2">
            <button 
              type="submit" 
              class="btn btn-save-trip text-center" 
              id="saveTripSubmitBtn"
              onclick="return prepareItinerarySubmission(event)"
            >
              <i class="fa-solid fa-cloud-arrow-up me-2"></i>
              <% if (typeof tripToEdit !== 'undefined' && tripToEdit) { %>
                Update Trip in My Trips
              <% } else { %>
                Save Trip to My Trips
              <% } %>
            </button>
            <a href="/my-trips" class="btn btn-outline-secondary rounded-pill py-2 text-center fw-semibold mt-2">
              Cancel & Return to My Trips
            </a>
          </div>

          <div class="card mt-3 border-0 bg-light-subtle rounded-3 p-3">
            <div class="small text-muted">
              <i class="fa-solid fa-shield-halved text-success me-1"></i>
              <strong>100% Manual Guarantee:</strong> Your trip schedules, route stops, and expenses are saved exactly as entered and persist in your private account.
            </div>
          </div>

        </div>
      </div>
    </div>
  </form>

</div>

<!-- ========================================== -->
<!-- 5. CLIENT-SIDE DATA & INTERACTIVE LOGIC   -->
<!-- ========================================== -->

<!-- JSON Data Injection -->
<script>
  // Selected destinations from user's planner basket
  const userPlannerPlaces = <%- JSON.stringify(
    (plannerPlaces || []).map(item => {
      const p = item.destination_id;
      if (!p) return null;
      return {
        _id: p._id,
        name: p.name,
        district: p.district,
        category: p.category,
        indianFee: p.entryFee?.indian !== undefined ? p.entryFee.indian : 0,
        images: p.images || []
      };
    }).filter(Boolean)
  ) %>;

  // Preloaded trip data if editing
  const existingTripData = <%- (typeof tripToEdit !== 'undefined' && tripToEdit) ? JSON.stringify(tripToEdit) : 'null' %>;

  let dayCounter = 0;

  // Initialize planner
  document.addEventListener("DOMContentLoaded", function() {
    if (existingTripData && existingTripData.days && existingTripData.days.length > 0) {
      // Load existing trip days
      existingTripData.days.forEach(d => {
        addNewDay(d);
      });
    } else {
      // Add default Day 1
      addNewDay();
    }

    calculateBudgetSummary();
  });

  // ============================================
  // DESTINATION SEARCH & FILTER IN PLANNER
  // ============================================
  function filterPlannerDestinations() {
    const searchVal = (document.getElementById("plannerSearchInput").value || "").toLowerCase().trim();
    const categoryVal = (document.getElementById("categoryFilter").value || "").toLowerCase().trim();
    const districtVal = (document.getElementById("districtFilter").value || "").toLowerCase().trim();

    const items = document.querySelectorAll("#destResultsGrid .dest-item");
    let visibleCount = 0;

    items.forEach(item => {
      const name = item.dataset.name || "";
      const dist = item.dataset.district || "";
      const cat = item.dataset.category || "";
      const desc = item.dataset.desc || "";

      const matchSearch = !searchVal || name.includes(searchVal) || dist.includes(searchVal) || cat.includes(searchVal) || desc.includes(searchVal);
      const matchCat = !categoryVal || cat === categoryVal;
      const matchDist = !districtVal || dist === districtVal;

      if (matchSearch && matchCat && matchDist) {
        item.classList.remove("d-none");
        visibleCount++;
      } else {
        item.classList.add("d-none");
      }
    });

    const noMatch = document.getElementById("noDestMatch");
    if (visibleCount === 0) {
      noMatch.classList.remove("d-none");
    } else {
      noMatch.classList.add("d-none");
    }
  }

  function resetPlannerFilters() {
    document.getElementById("plannerSearchInput").value = "";
    document.getElementById("categoryFilter").value = "";
    document.getElementById("districtFilter").value = "";
    filterPlannerDestinations();
  }

  // ============================================
  // ADD & REMOVE ITINERARY DAYS
  // ============================================
  function addNewDay(dayData = null) {
    dayCounter++;
    const dayNumber = document.querySelectorAll(".day-card").length + 1;
    const dayId = "dayCard_" + dayCounter;

    const initialTitle = dayData ? (dayData.title || `Day ${dayNumber} Itinerary`) : `Day ${dayNumber} Itinerary`;
    const initialDate = dayData ? (dayData.date || "") : "";

    const dayCardHtml = `
      <div class="day-card" id="${dayId}" data-day-index="${dayNumber}">
        <div class="day-header">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="day-badge day-number-badge">Day ${dayNumber}</span>
            <input 
              type="text" 
              class="form-control form-control-sm day-title-input fw-bold" 
              value="${initialTitle.replace(/"/g, '&quot;')}" 
              placeholder="e.g., Morning Fort Trek & City Highlights"
              style="max-width: 320px;"
            >
          </div>
          <div class="d-flex align-items-center gap-2">
            <input 
              type="date" 
              class="form-control form-control-sm day-date-input" 
              value="${initialDate}"
              title="Visit Date for Day ${dayNumber}"
              style="max-width: 150px;"
            >
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeDay('${dayId}')" title="Delete this day">
              <i class="fa-solid fa-trash-can"></i> Remove Day
            </button>
          </div>
        </div>

        <div class="p-3">
          <div class="activities-list" id="${dayId}_activities">
            <!-- Activities will be inserted here -->
          </div>

          <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
            <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-semibold" onclick="addNewActivity('${dayId}')">
              <i class="fa-solid fa-plus me-1"></i> Add Destination / Activity to Day <span class="day-inline-num">${dayNumber}</span>
            </button>
          </div>
        </div>
      </div>
    `;

    document.getElementById("daysContainer").insertAdjacentHTML("beforeend", dayCardHtml);

    // If dayData provided with activities, render them
    if (dayData && dayData.activities && dayData.activities.length > 0) {
      dayData.activities.forEach(act => {
        addNewActivity(dayId, act);
      });
    } else {
      // Add one default empty activity row for convenience
      addNewActivity(dayId);
    }

    renumberDays();
    calculateBudgetSummary();
  }

  function removeDay(dayId) {
    const totalDays = document.querySelectorAll(".day-card").length;
    if (totalDays <= 1) {
      alert("A trip itinerary must contain at least one day.");
      return;
    }

    if (confirm("Are you sure you want to remove this day and its activities from your itinerary?")) {
      const el = document.getElementById(dayId);
      if (el) {
        el.remove();
        renumberDays();
        calculateBudgetSummary();
      }
    }
  }

  function renumberDays() {
    const cards = document.querySelectorAll(".day-card");
    cards.forEach((card, idx) => {
      const num = idx + 1;
      card.setAttribute("data-day-index", num);
      const badge = card.querySelector(".day-number-badge");
      if (badge) badge.innerText = "Day " + num;
      const inlineNum = card.querySelector(".day-inline-num");
      if (inlineNum) inlineNum.innerText = num;
    });

    const countLabel = document.getElementById("totalDaysCountLabel");
    if (countLabel) countLabel.innerText = `Total Days: ${cards.length}`;
  }

  // ============================================
  // ADD & REMOVE ACTIVITY / DESTINATION ROWS
  // ============================================
  let activityCounter = 0;

  function addNewActivity(dayId, actData = null) {
    activityCounter++;
    const actContainer = document.getElementById(`${dayId}_activities`);
    if (!actContainer) return;

    const actRowId = `act_${activityCounter}`;

    // Options for destination select
    let optionsHtml = `<option value="">-- Select from Planner Destinations or Enter Custom --</option>`;
    userPlannerPlaces.forEach(p => {
      const isSelected = actData && (actData.placeId === p._id || actData.place === p.name);
      optionsHtml += `<option value="${p._id}" data-name="${p.name.replace(/"/g, '&quot;')}" data-fee="${p.indianFee || 0}" ${isSelected ? 'selected' : ''}>
        📍 ${p.name} (${p.district} - ${p.category})
      </option>`;
    });
    optionsHtml += `<option value="custom" ${actData && !actData.placeId ? 'selected' : ''}>✏️ Custom Stop / Meal / Transit / Hotel</option>`;

    const customPlaceName = actData ? (actData.place || "") : "";
    const arrivalTime = actData ? (actData.arrivalTime || actData.time || "") : "";
    const departureTime = actData ? (actData.departureTime || "") : "";
    const duration = actData ? (actData.duration || "") : "";
    const transportMode = actData ? (actData.transportMode || "") : "";
    const transportCost = actData ? (actData.transportCost || "") : 0;
    const entryFee = actData ? (actData.entryFee || "") : 0;
    const foodCost = actData ? (actData.foodCost || "") : 0;
    const notes = actData ? (actData.notes || actData.description || "") : "";

    const rowHtml = `
      <div class="activity-row" id="${actRowId}">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="d-flex align-items-center gap-2">
            <span class="activity-index-badge">#</span>
            <strong class="text-dark">Stop / Activity</strong>
          </div>
          <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removeActivity('${actRowId}')" title="Remove stop">
            <i class="fa-solid fa-circle-xmark fs-5"></i>
          </button>
        </div>

        <div class="row g-2">
          <!-- Destination Dropdown -->
          <div class="col-md-6 col-sm-12">
            <label class="form-label small mb-1">Destination / Stop <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm dest-selector" onchange="onDestinationSelectChange('${actRowId}')">
              ${optionsHtml}
            </select>
          </div>

          <!-- Custom Destination Name (shown if custom or manual override) -->
          <div class="col-md-6 col-sm-12 custom-name-col">
            <label class="form-label small mb-1">Place Name / Title</label>
            <input 
              type="text" 
              class="form-control form-control-sm act-place-name" 
              placeholder="e.g., Sinhagad Fort, Hotel Check-in, Express Highway Stop" 
              value="${customPlaceName.replace(/"/g, '&quot;')}"
            >
          </div>

          <!-- Arrival & Departure Times -->
          <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Arrival Time</label>
            <input 
              type="text" 
              class="form-control form-control-sm act-arrival" 
              placeholder="e.g., 09:30 AM" 
              value="${arrivalTime.replace(/"/g, '&quot;')}"
            >
          </div>

          <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Departure Time</label>
            <input 
              type="text" 
              class="form-control form-control-sm act-departure" 
              placeholder="e.g., 12:30 PM" 
              value="${departureTime.replace(/"/g, '&quot;')}"
            >
          </div>

          <!-- Duration -->
          <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Expected Duration</label>
            <input 
              type="text" 
              class="form-control form-control-sm act-duration" 
              placeholder="e.g., 2 hrs 30 min" 
              value="${duration.replace(/"/g, '&quot;')}"
            >
          </div>

          <!-- Transport Mode -->
          <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Transport Mode</label>
            <select class="form-select form-select-sm act-transport-mode">
              <option value="">Select Mode</option>
              <option value="Car / Taxi" ${transportMode === 'Car / Taxi' ? 'selected' : ''}>🚗 Car / Taxi</option>
              <option value="Bus / MSRTC" ${transportMode === 'Bus / MSRTC' ? 'selected' : ''}>🚌 Bus / MSRTC</option>
              <option value="Train" ${transportMode === 'Train' ? 'selected' : ''}>🚆 Train</option>
              <option value="Bike / Two-Wheeler" ${transportMode === 'Bike / Two-Wheeler' ? 'selected' : ''}>🏍️ Bike</option>
              <option value="Auto-Rickshaw" ${transportMode === 'Auto-Rickshaw' ? 'selected' : ''}>🛺 Auto-Rickshaw</option>
              <option value="Walking / Trekking" ${transportMode === 'Walking / Trekking' ? 'selected' : ''}>🚶 Trekking / Walk</option>
              <option value="Flight / Other" ${transportMode === 'Flight / Other' ? 'selected' : ''}>✈️ Other</option>
            </select>
          </div>

          <!-- Manual Expenses: Transport, Entry, Food -->
          <div class="col-md-4 col-sm-4 col-4">
            <label class="form-label small mb-1">Transport Cost (₹)</label>
            <input 
              type="number" 
              class="form-control form-control-sm expense-input act-cost-transport" 
              min="0" 
              step="10" 
              placeholder="0" 
              value="${transportCost}" 
              oninput="calculateBudgetSummary()"
            >
          </div>

          <div class="col-md-4 col-sm-4 col-4">
            <label class="form-label small mb-1">Entry Fee (₹)</label>
            <input 
              type="number" 
              class="form-control form-control-sm expense-input act-cost-entry" 
              min="0" 
              step="10" 
              placeholder="0" 
              value="${entryFee}" 
              oninput="calculateBudgetSummary()"
            >
          </div>

          <div class="col-md-4 col-sm-4 col-4">
            <label class="form-label small mb-1">Food / Snacks (₹)</label>
            <input 
              type="number" 
              class="form-control form-control-sm expense-input act-cost-food" 
              min="0" 
              step="10" 
              placeholder="0" 
              value="${foodCost}" 
              oninput="calculateBudgetSummary()"
            >
          </div>

          <!-- Notes / Activities -->
          <div class="col-12">
            <input 
              type="text" 
              class="form-control form-control-sm act-notes" 
              placeholder="Activities / Notes: e.g., Photography, sunset viewpoint, taste local food" 
              value="${notes.replace(/"/g, '&quot;')}"
            >
          </div>
        </div>
      </div>
    `;

    actContainer.insertAdjacentHTML("beforeend", rowHtml);
    renumberActivities(dayId);
    calculateBudgetSummary();
  }

  function removeActivity(actRowId) {
    const row = document.getElementById(actRowId);
    if (row) {
      const parent = row.closest(".activities-list");
      row.remove();
      if (parent) {
        renumberActivities(parent.id.replace("_activities", ""));
      }
      calculateBudgetSummary();
    }
  }

  function renumberActivities(dayId) {
    const actContainer = document.getElementById(`${dayId}_activities`);
    if (!actContainer) return;
    const badges = actContainer.querySelectorAll(".activity-index-badge");
    badges.forEach((b, i) => {
      b.innerText = i + 1;
    });
  }

  function onDestinationSelectChange(actRowId) {
    const row = document.getElementById(actRowId);
    if (!row) return;

    const select = row.querySelector(".dest-selector");
    const nameInput = row.querySelector(".act-place-name");
    const entryFeeInput = row.querySelector(".act-cost-entry");

    const selectedOption = select.options[select.selectedIndex];
    const placeId = selectedOption.value;

    if (placeId && placeId !== "custom") {
      const placeName = selectedOption.dataset.name || "";
      const fee = parseFloat(selectedOption.dataset.fee) || 0;

      nameInput.value = placeName;
      if (!entryFeeInput.value || entryFeeInput.value === "0") {
        entryFeeInput.value = fee;
      }
    } else if (placeId === "custom") {
      if (!nameInput.value) {
        nameInput.placeholder = "Enter custom location / activity name";
      }
    }

    calculateBudgetSummary();
  }

  // ============================================
  // LIVE BUDGET SUMMARY CALCULATION
  // ============================================
  function calculateBudgetSummary() {
    let totalTransport = 0;
    let totalFood = 0;
    let totalEntry = 0;
    let totalOther = 0;

    // Sum up from all activity rows
    document.querySelectorAll(".activity-row").forEach(row => {
      const t = parseFloat(row.querySelector(".act-cost-transport")?.value) || 0;
      const f = parseFloat(row.querySelector(".act-cost-food")?.value) || 0;
      const e = parseFloat(row.querySelector(".act-cost-entry")?.value) || 0;

      totalTransport += Math.max(0, t);
      totalFood += Math.max(0, f);
      totalEntry += Math.max(0, e);
    });

    const totalEstimated = totalTransport + totalFood + totalEntry + totalOther;

    document.getElementById("summaryTransport").innerText = "₹" + totalTransport.toLocaleString('en-IN');
    document.getElementById("summaryFood").innerText = "₹" + totalFood.toLocaleString('en-IN');
    document.getElementById("summaryEntry").innerText = "₹" + totalEntry.toLocaleString('en-IN');
    document.getElementById("summaryOther").innerText = "₹" + totalOther.toLocaleString('en-IN');
    document.getElementById("summaryTotal").innerText = "₹" + totalEstimated.toLocaleString('en-IN');

    // Planned Budget & Remaining calculation
    const plannedBudgetVal = parseFloat(document.getElementById("plannedBudget").value) || 0;
    const remainingBox = document.getElementById("budgetRemainingBox");
    const remainingAmountEl = document.getElementById("remainingAmount");
    const budgetStatusMsgEl = document.getElementById("budgetStatusMsg");

    if (plannedBudgetVal > 0) {
      const remaining = plannedBudgetVal - totalEstimated;
      remainingAmountEl.innerText = (remaining < 0 ? "-₹" : "₹") + Math.abs(remaining).toLocaleString('en-IN');

      if (remaining >= 0) {
        remainingBox.className = "budget-remaining within mt-3";
        budgetStatusMsgEl.innerText = `Within budget (₹${remaining.toLocaleString('en-IN')} remaining)`;
      } else {
        remainingBox.className = "budget-remaining exceeded mt-3";
        budgetStatusMsgEl.innerText = `⚠️ Budget exceeded by ₹${Math.abs(remaining).toLocaleString('en-IN')}`;
      }
    } else {
      remainingBox.className = "budget-remaining within mt-3";
      remainingAmountEl.innerText = "₹0";
      budgetStatusMsgEl.innerText = "Enter a planned budget to track your balance";
    }
  }

  // ============================================
  // SUBMISSION VALIDATION & PAYLOAD COMPILATION
  // ============================================
  function prepareItinerarySubmission(event) {
    const tripName = document.getElementById("tripName").value.trim();
    const startingCity = document.getElementById("startingCity").value.trim();
    const startDate = document.getElementById("startDate").value;
    const travelers = parseInt(document.getElementById("travelers").value) || 1;
    const plannedBudget = parseFloat(document.getElementById("plannedBudget").value) || 0;
    const notes = document.getElementById("tripNotes").value.trim();

    if (!tripName) {
      alert("Please enter a Trip Name.");
      document.getElementById("tripName").focus();
      event.preventDefault();
      return false;
    }

    if (!startingCity) {
      alert("Please enter a Starting City.");
      document.getElementById("startingCity").focus();
      event.preventDefault();
      return false;
    }

    if (!startDate) {
      alert("Please choose a Travel Start Date.");
      document.getElementById("startDate").focus();
      event.preventDefault();
      return false;
    }

    const dayCards = document.querySelectorAll(".day-card");
    if (dayCards.length === 0) {
      alert("Please add at least one day to your itinerary.");
      event.preventDefault();
      return false;
    }

    const daysPayload = [];
    let totalActivitiesCount = 0;
    let grandTransport = 0;
    let grandFood = 0;
    let grandEntry = 0;
    let grandTotal = 0;

    for (let i = 0; i < dayCards.length; i++) {
      const card = dayCards[i];
      const dayNum = i + 1;
      const titleInput = card.querySelector(".day-title-input");
      const dateInput = card.querySelector(".day-date-input");

      const dayTitle = (titleInput ? titleInput.value.trim() : "") || `Day ${dayNum}`;
      const dayDate = dateInput ? dateInput.value : "";

      const actRows = card.querySelectorAll(".activity-row");
      const activities = [];

      actRows.forEach(row => {
        const destSelect = row.querySelector(".dest-selector");
        const placeNameInput = row.querySelector(".act-place-name");
        const arrivalInput = row.querySelector(".act-arrival");
        const departureInput = row.querySelector(".act-departure");
        const durationInput = row.querySelector(".act-duration");
        const modeSelect = row.querySelector(".act-transport-mode");
        const costT = Math.max(0, parseFloat(row.querySelector(".act-cost-transport")?.value) || 0);
        const costE = Math.max(0, parseFloat(row.querySelector(".act-cost-entry")?.value) || 0);
        const costF = Math.max(0, parseFloat(row.querySelector(".act-cost-food")?.value) || 0);
        const actNotes = row.querySelector(".act-notes")?.value.trim() || "";

        let placeId = destSelect ? destSelect.value : "";
        if (placeId === "custom" || !placeId) {
          placeId = undefined;
        }

        const placeName = (placeNameInput ? placeNameInput.value.trim() : "") || (destSelect && destSelect.selectedIndex > 0 ? destSelect.options[destSelect.selectedIndex].text : "Stop");

        // Only add if there is at least a name or timing or notes
        if (placeName || arrivalInput?.value || actNotes) {
          activities.push({
            time: arrivalInput ? arrivalInput.value.trim() : "",
            arrivalTime: arrivalInput ? arrivalInput.value.trim() : "",
            departureTime: departureInput ? departureInput.value.trim() : "",
            type: "visit",
            place: placeName,
            placeId: placeId,
            duration: durationInput ? durationInput.value.trim() : "",
            description: actNotes,
            notes: actNotes,
            transportMode: modeSelect ? modeSelect.value : "",
            transportCost: costT,
            entryFee: costE,
            foodCost: costF,
            otherCost: 0
          });

          grandTransport += costT;
          grandEntry += costE;
          grandFood += costF;
          totalActivitiesCount++;
        }
      });

      daysPayload.push({
        day: dayNum,
        title: dayTitle,
        date: dayDate,
        activities: activities
      });
    }

    if (totalActivitiesCount === 0) {
      alert("Please add at least one stop or activity to your itinerary.");
      event.preventDefault();
      return false;
    }

    grandTotal = grandTransport + grandFood + grandEntry;

    // Compile complete itinerary object
    const completeTrip = {
      tripName: tripName,
      title: tripName,
      startingCity: startingCity,
      startDate: startDate,
      travelers: travelers,
      budget: plannedBudget,
      notes: notes,
      tripType: "manual",
      summary: `${daysPayload.length}-day manual trip from ${startingCity} exploring Maharashtra destinations, for ${travelers} traveler(s) with an estimated cost of ₹${grandTotal.toLocaleString('en-IN')}.`,
      days: daysPayload,
      estimatedCost: {
        travel: grandTransport,
        food: grandFood,
        entryFees: grandEntry,
        other: 0,
        total: grandTotal
      }
    };

    // Serialize into hidden input
    document.getElementById("itineraryPayload").value = JSON.stringify(completeTrip);
    return true;
  }
</script>
