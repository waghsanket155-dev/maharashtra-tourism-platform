<% layout("layout/boilerplate") %>
<style>
  /* ================================
     MY SAVED TRIPS PAGE
  ================================= */

  .my-trips-page {
    min-height: 100vh;
    padding: 70px 20px 110px;
    background:
      radial-gradient(circle at 5% 5%, rgba(25, 135, 84, 0.12), transparent 28%),
      radial-gradient(circle at 95% 90%, rgba(0, 123, 255, 0.08), transparent 30%),
      linear-gradient(135deg, #f7fcf9 0%, #eef8f3 100%);
  }

  /* ================================
     HEADER
  ================================= */

  .trips-heading {
    text-align: center;
    margin-bottom: 55px;
    animation: headingReveal 0.8s ease forwards;
  }

  .heading-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 22px;

    background: linear-gradient(
      135deg,
      #198754,
      #0d6efd
    );

    color: white;
    font-size: 34px;

    box-shadow:
      0 15px 35px rgba(25, 135, 84, 0.25);

    animation: floating 3s ease-in-out infinite;
  }

  .trips-heading h1 {
    margin: 0;

    font-size: clamp(32px, 5vw, 48px);
    font-weight: 900;

    background: linear-gradient(
      90deg,
      #123c2b,
      #198754,
      #0d6efd
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .trips-heading p {
    margin-top: 12px;

    color: #718078;
    font-size: 16px;
  }


  /* ================================
     GRID
  ================================= */

  .trips-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
    max-width: 1180px;
    margin: auto;
  }


  /* ================================
     CARD
  ================================= */

  .trip-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(25, 135, 84, 0.10);
    box-shadow: 0 12px 35px rgba(18, 60, 43, 0.08);
    transition: transform 0.45s cubic-bezier(.2,.8,.2,1), box-shadow 0.45s ease;
    animation: cardReveal 0.7s ease both;
  }

  .trip-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 60px rgba(18, 60, 43, 0.17);
  }


  /* ================================
     TOP VISUAL
  ================================= */

  .trip-visual {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, #126b47, #1d9b67, #0d6efd);
  }

  .trip-visual::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: rgba(255,255,255,0.13);
    top: -150px;
    right: -90px;
    transition: transform 0.7s ease;
  }

  .trip-card:hover .trip-visual::before {
    transform: scale(1.3) rotate(20deg);
  }

  .trip-visual::after {
    content: "";
    position: absolute;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    bottom: -120px;
    left: -50px;
    transition: transform 0.7s ease;
  }

  .trip-card:hover .trip-visual::after {
    transform: scale(1.4);
  }

  .trip-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 5;
    padding: 8px 15px;
    border-radius: 50px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    color: #176b47;
    font-size: 12px;
    font-weight: 800;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  }

  .trip-type-tag {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 5;
    padding: 7px 14px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tag-manual {
    background: #e8f6ef;
    color: #126b47;
    border: 1px solid #b8e6cf;
  }

  .tag-ai {
    background: #e8f0fe;
    color: #1a73e8;
    border: 1px solid #c2d7fa;
  }

  .travel-icon {
    position: absolute;
    right: 35px;
    bottom: 15px;
    z-index: 2;
    font-size: 85px;
    filter: drop-shadow(0 12px 10px rgba(0,0,0,0.15));
    transition: transform 0.5s ease;
  }

  .trip-card:hover .travel-icon {
    transform: translateY(-8px) rotate(-5deg) scale(1.06);
  }

  /* ================================
     CARD BODY
  ================================= */

  .trip-body {
    padding: 24px;
  }

  .trip-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .trip-title-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: #e8f6ef;
    font-size: 20px;
  }

  .trip-title h3 {
    margin: 0;
    color: #183c2c;
    font-size: 21px;
    font-weight: 850;
    line-height: 1.3;
  }

  .trip-summary {
    color: #697a72;
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
  }

  /* ================================
     INFO GRID
  ================================= */

  .trip-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }

  .info-box {
    padding: 11px 10px;
    border-radius: 14px;
    background: linear-gradient(135deg, #f5faf7, #edf7f2);
    border: 1px solid #e0eee7;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .info-box:hover {
    transform: translateY(-3px);
    background: #e5f5ed;
  }

  .info-label {
    display: block;
    margin-bottom: 3px;
    color: #8a9791;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .info-value {
    color: #24533e;
    font-size: 13.5px;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ================================
     FOOTER
  ================================= */

  .trip-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid #edf2ef;
    flex-wrap: wrap;
  }

  .saved-date {
    color: #8b9690;
    font-size: 11px;
    line-height: 1.5;
  }

  .saved-date strong {
    color: #4d6258;
    font-size: 12px;
  }

  /* ================================
     BUTTONS
  ================================= */

  .trip-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 12px;
    background: linear-gradient(135deg, #198754, #157347);
    color: white !important;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 6px 16px rgba(25,135,84,0.22);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .view-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(25,135,84,0.32);
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #eaf7f0;
    color: #198754 !important;
    border: 1px solid #c2e5d3;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: all 0.25s ease;
  }

  .edit-btn:hover {
    background: #198754;
    color: white !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(25,135,84,0.2);
  }

  .delete-btn {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid #ffd7d7;
    background: #fff5f5;
    color: #dc3545;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .delete-btn:hover {
    background: #dc3545;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(220,53,69,0.22);
  }

  /* ================================
     EMPTY STATE
  ================================= */

  .empty-state {
    max-width: 650px;
    margin: 20px auto;
    padding: 60px 35px;
    text-align: center;
    background: rgba(255,255,255,0.95);
    border-radius: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.07);
    border: 1px solid rgba(25, 135, 84, 0.12);
    animation: cardReveal 0.8s ease;
  }

  .empty-icon {
    font-size: 72px;
    margin-bottom: 15px;
    animation: floating 3s ease-in-out infinite;
  }

  .empty-state h3 {
    color: #183c2c;
    font-weight: 850;
    margin-bottom: 10px;
  }

  .empty-state p {
    color: #74827b;
    line-height: 1.7;
    margin-bottom: 25px;
  }

  .plan-btn-group {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .plan-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 14px;
    background: linear-gradient(135deg, #198754, #157347);
    color: white !important;
    text-decoration: none;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(25, 135, 84, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .plan-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(25, 135, 84, 0.35);
  }

  .plan-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border-radius: 14px;
    background: #f0f7f3;
    color: #198754 !important;
    border: 1px solid #c2e5d3;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.25s ease;
  }

  .plan-btn-secondary:hover {
    background: #e2f2e9;
    transform: translateY(-3px);
  }

  @keyframes headingReveal {
    from { opacity: 0; transform: translateY(-25px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes cardReveal {
    from { opacity: 0; transform: translateY(40px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes floating {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 900px) {
    .trips-grid {
      grid-template-columns: 1fr;
      max-width: 620px;
    }
  }

  .start-trip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0d6efd, #0056d6);
    color: white !important;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 6px 16px rgba(13,110,253,0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .start-trip-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(13,110,253,0.38);
    color: white !important;
  }

  .trip-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .status-not-started { background: #f0f0f0; color: #666; }
  .status-in-progress { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
  .status-paused { background: #e8f0fe; color: #1a73e8; border: 1px solid #93b4f8; }
  .status-completed { background: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
</style>

<div class="my-trips-page">
  <div class="container-fluid">

    <!-- HEADER -->
    <div class="trips-heading">
      <div class="heading-icon">
        <i class="fa-solid fa-heart"></i>
      </div>
      <h1>My Saved Trips</h1>
      <p>
        Your personalized Maharashtra adventures, saved and ready to explore anytime.
      </p>
      <div class="mt-3">
        <a href="/m-planner" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm me-2">
          <i class="fa-solid fa-plus me-1"></i> Create Manual Trip
        </a>
        <a href="/explore" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
          <i class="fa-solid fa-compass me-1"></i> Explore Destinations
        </a>
      </div>
    </div>

    <% if (!trips || trips.length === 0) { %>

      <!-- EMPTY STATE -->
      <div class="empty-state">
        <div class="empty-icon">🧳</div>
        <h3>No Trips Saved Yet</h3>
        <p>
          You haven't saved any trips yet. You can build a complete multi-day itinerary with our Manual Trip Planner, or generate an itinerary with our AI Trip Planner.
        </p>

        <div class="plan-btn-group">
          <a href="/m-planner" class="plan-btn-primary">
            <i class="fa-solid fa-route"></i>
            Create Manual Trip
          </a>
          <a href="/planner" class="plan-btn-secondary">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Plan with AI
          </a>
        </div>
      </div>

    <% } else { %>

      <!-- TRIPS GRID -->
      <div class="trips-grid">

        <% trips.forEach((trip, index) => { 
            const isManual = trip.tripType === 'manual' || !trip.tripType;
            const tripTitle = trip.tripName || trip.title || "Maharashtra Trip";
            const startingCity = trip.startingCity || "Maharashtra";
            const startDate = trip.startDate || (trip.createdAt ? trip.createdAt.toLocaleDateString() : "Flexible");
            const travelers = trip.travelers || 1;
            const daysCount = trip.days?.length || 0;
            const tripStatus = trip.tripStatus || 'not_started';

            let formattedCost = "N/A";
            if (trip.estimatedCost?.total !== undefined && trip.estimatedCost?.total !== null) {
              if (typeof trip.estimatedCost.total === 'number') {
                formattedCost = "₹" + trip.estimatedCost.total.toLocaleString('en-IN');
              } else {
                formattedCost = trip.estimatedCost.total;
              }
            }

            const statusLabels = { not_started: 'Not Started', in_progress: 'In Progress', paused: 'Paused', completed: 'Completed' };
            const statusIcons = { not_started: '⭕', in_progress: '🚀', paused: '⏸️', completed: '✅' };
        %>

          <div class="trip-card" style="animation-delay: <%= index * 0.1 %>s;">

            <!-- VISUAL SECTION -->
            <div class="trip-visual">
              <span class="trip-badge">
                <i class="fa-solid fa-location-dot me-1"></i>
                <%= startingCity %>
              </span>

              <% if (isManual) { %>
                <span class="trip-type-tag tag-manual">
                  <i class="fa-solid fa-pen-nib me-1"></i> Manual Plan
                </span>
              <% } else { %>
                <span class="trip-type-tag tag-ai">
                  <i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI Plan
                </span>
              <% } %>

              <div class="travel-icon">
                <%= isManual ? '🧭' : '🏔️' %>
              </div>
            </div>

            <!-- BODY -->
            <div class="trip-body">

              <!-- Trip Status Badge -->
              <div class="trip-status-badge status-<%= tripStatus.replace('_', '-') %>">
                <%= statusIcons[tripStatus] || '⭕' %> <%= statusLabels[tripStatus] || tripStatus %>
              </div>

              <div class="trip-title">
                <div class="trip-title-icon">
                  <%= isManual ? '🗺️' : '✨' %>
                </div>
                <h3>
                  <%= tripTitle %>
                </h3>
              </div>

              <!-- SUMMARY -->
              <div class="trip-summary">
                <%= trip.summary || "Your custom Maharashtra travel adventure is ready to be explored." %>
              </div>

              <!-- INFO GRID -->
              <div class="trip-info">
                <!-- Starting City -->
                <div class="info-box">
                  <span class="info-label">From</span>
                  <span class="info-value" title="<%= startingCity %>">
                    <i class="fa-solid fa-location-arrow text-success me-1"></i>
                    <%= startingCity %>
                  </span>
                </div>

                <!-- Duration -->
                <div class="info-box">
                  <span class="info-label">Duration</span>
                  <span class="info-value">
                    <i class="fa-regular fa-calendar text-primary me-1"></i>
                    <%= daysCount %> <%= daysCount === 1 ? 'Day' : 'Days' %>
                  </span>
                </div>

                <!-- Travelers -->
                <div class="info-box">
                  <span class="info-label">Travelers</span>
                  <span class="info-value">
                    <i class="fa-solid fa-user-group text-warning me-1"></i>
                    <%= travelers %> <%= travelers === 1 ? 'Person' : 'Persons' %>
                  </span>
                </div>

                <!-- Start Date -->
                <div class="info-box">
                  <span class="info-label">Start Date</span>
                  <span class="info-value">
                    <i class="fa-regular fa-clock text-info me-1"></i>
                    <%= startDate %>
                  </span>
                </div>

                <!-- Estimated Cost -->
                <div class="info-box" style="grid-column: span 2;">
                  <span class="info-label">Estimated Cost</span>
                  <span class="info-value text-success">
                    <i class="fa-solid fa-indian-rupee-sign me-1"></i>
                    <%= formattedCost %>
                  </span>
                </div>
              </div>

              <!-- FOOTER -->
              <div class="trip-footer">

                <div class="saved-date">
                  Saved on
                  <br>
                  <strong>
                    <%= trip.createdAt ? trip.createdAt.toLocaleDateString() : "Unknown" %>
                  </strong>
                </div>

                <div class="trip-actions">
                  <!-- START TRIP (Companion) -->
                  <% if (tripStatus !== 'completed') { %>
                    <a href="/my-trips/<%= trip._id %>/start" class="start-trip-btn" title="<%= tripStatus === 'in_progress' ? 'Continue Trip' : (tripStatus === 'paused' ? 'Resume Trip' : 'Start Trip') %>">
                      <i class="fa-solid fa-<%= tripStatus === 'in_progress' ? 'play-circle' : (tripStatus === 'paused' ? 'rotate-right' : 'rocket') %>"></i>
                      <%= tripStatus === 'in_progress' ? 'Continue' : (tripStatus === 'paused' ? 'Resume' : 'Start Trip') %>
                    </a>
                  <% } else { %>
                    <span class="start-trip-btn" style="background:linear-gradient(135deg,#198754,#0f5132);opacity:0.75;cursor:default;" title="Trip Completed">
                      <i class="fa-solid fa-check-circle"></i> Completed
                    </span>
                  <% } %>

                  <!-- VIEW TRIP -->
                  <a href="/my-trips/<%= trip._id %>" class="view-btn">
                    <i class="fa-solid fa-map-location-dot"></i>
                    View
                  </a>

                  <!-- EDIT TRIP (FOR MANUAL TRIPS) -->
                  <% if (isManual && tripStatus !== 'completed') { %>
                    <a href="/my-trips/<%= trip._id %>/edit" class="edit-btn" title="Edit Trip Details">
                      <i class="fa-solid fa-pen-to-square"></i>
                      Edit
                    </a>
                  <% } %>

                  <!-- DELETE TRIP -->
                  <form
                    action="/my-trips/<%= trip._id %>?_method=DELETE"
                    method="POST"
                    style="margin:0;"
                    onsubmit="return confirm('Are you sure you want to delete this saved trip?');"
                  >
                    <button type="submit" class="delete-btn" title="Delete Trip">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </div>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </div>
</div>
