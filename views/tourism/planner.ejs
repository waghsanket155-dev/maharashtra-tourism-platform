<% layout ("layout/boilerplate")%>
<style>

  /* ============================================================
     1. TOKENS
     ============================================================ */
  :root{
    --primary:      #198754;
    --primary-dark: #173F2C;
    --light-green:  #EAF8F0;
    --sand:         #C98A4B;
    --bg:           #FBF9F3;
    --ink:          #16231C;
    --ink-soft:     #5B6B60;
    --line:         #DCE6DE;
    --glass:        rgba(255,255,255,0.62);
    --radius-lg:    28px;
    --radius-md:    16px;
    --radius-sm:    999px;
    --shadow-soft:  0 30px 60px -30px rgba(23,63,44,0.25);
    --ease:         cubic-bezier(.22,1,.36,1);
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    margin:0;
    font-family:'Inter', sans-serif;
    color:var(--ink);
    background:var(--bg);
    min-height:100vh;
    position:relative;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  /* ============================================================
     2. AMBIENT BACKGROUND
     ============================================================ */
  .bg-decor{
    position:fixed; inset:0; z-index:0; overflow:hidden; pointer-events:none;
  }
  .blob{
    position:absolute;
    border-radius:50%;
    filter:blur(70px);
    opacity:0.35;
  }
  .blob-a{
    width:520px; height:520px; top:-180px; right:-140px;
    background:radial-gradient(circle at 30% 30%, var(--light-green), transparent 70%);
    animation:drift 22s ease-in-out infinite;
  }
  .blob-b{
    width:420px; height:420px; bottom:-160px; left:-120px;
    background:radial-gradient(circle at 60% 40%, #F4E7D6, transparent 70%);
    animation:drift 26s ease-in-out infinite reverse;
  }
  @keyframes drift{
    0%,100%{ transform:translate(0,0) scale(1); }
    50%{ transform:translate(30px,-24px) scale(1.06); }
  }

  /* ============================================================
     3. LAYOUT
     ============================================================ */
  .page {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0 4%;
   padding:20px 24px 50px;
}

  .intro{ text-align:center; margin-bottom:52px; }

  .ai-badge{
    display:inline-flex; align-items:center; gap:8px;
    padding:7px 16px;
    border-radius:var(--radius-sm);
    background:var(--light-green);
    color:var(--primary-dark);
    font-size:13px; font-weight:600; letter-spacing:.2px;
    border:1px solid rgba(25,135,84,0.18);
  }
  .spark{
    display:inline-block;
    color:var(--primary);
    animation:pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{ transform:scale(1) rotate(0deg); opacity:1; }
    50%{ transform:scale(1.25) rotate(15deg); opacity:.6; }
  }

  h1{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(32px, 4.4vw, 48px);
    line-height:1.12;
    letter-spacing:-0.5px;
    margin:20px 0 14px;
    color:var(--primary-dark);
  }

  .lede{
    max-width:480px;
    margin:0 auto;
    color:var(--ink-soft);
    font-size:16px;
    line-height:1.6;
  }

  /* ============================================================
     4. THE PLANNER — glass panel with a route line
     ============================================================ */
  .planner{
    position:relative;
    background:var(--glass);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.6);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow-soft);
    padding:16px 40px 40px;
  }

  /* the dotted route connecting every stop, like a map path */
  .planner::before{
    content:"";
    position:absolute;
    left:56px;
    top:70px;
    bottom:120px;
    width:2px;
    background:repeating-linear-gradient(
      to bottom,
      var(--primary) 0 6px,
      transparent 6px 14px
    );
    opacity:0.35;
  }

  .stop{
    position:relative;
    display:flex;
    gap:20px;
    padding:26px 0;
    opacity:0;
    transform:translateY(14px);
    animation:rise .7s var(--ease) forwards;
  }
  .stop + .stop{ border-top:1px solid var(--line); }
  .stop:nth-child(1){ animation-delay:.05s; }
  .stop:nth-child(2){ animation-delay:.14s; }
  .stop:nth-child(3){ animation-delay:.23s; }
  .stop:nth-child(4){ animation-delay:.32s; }
  .stop:nth-child(5){ animation-delay:.41s; }
  .stop:nth-child(6){ animation-delay:.50s; }

  @keyframes rise{
    to{ opacity:1; transform:translateY(0); }
  }

  .stop-marker{
    flex:none;
    width:40px; height:40px;
    border-radius:50%;
    background:#fff;
    border:1.5px solid var(--primary);
    color:var(--primary-dark);
    display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces', serif;
    font-size:15px;
    z-index:1;
  }

  .stop-body{ flex:1; min-width:0; padding-top:6px; }

  label{
    display:block;
    font-weight:600;
    font-size:16px;
    margin-bottom:14px;
    color:var(--ink);
  }
  .hint{
    font-weight:400;
    font-size:13px;
    color:var(--ink-soft);
    margin-left:6px;
  }

  /* ---- text input ---- */
  .input-shell{
    display:flex; align-items:center; gap:10px;
    background:#fff;
    border:1.5px solid var(--line);
    border-radius:var(--radius-md);
    padding:14px 18px;
    transition:border-color .25s var(--ease), box-shadow .25s var(--ease);
  }
  .input-shell:focus-within{
    border-color:var(--primary);
    box-shadow:0 0 0 4px rgba(25,135,84,0.12);
  }
  .input-icon{ font-size:16px; }
  .input-shell input{
    border:none; outline:none; flex:1;
    font-family:'Inter', sans-serif;
    font-size:15px; color:var(--ink); background:transparent;
  }
  .input-shell input::placeholder{ color:#A7B3AC; }

  /* ---- chips (shared by checkbox + radio groups) ---- */
  .chip-group{
    display:flex; flex-wrap:wrap; gap:10px;
  }
  .chip{ position:relative; }
  .chip input{
    position:absolute; opacity:0; width:0; height:0;
  }
  .chip label{
    display:inline-flex; align-items:center; gap:8px;
    margin:0;
    padding:10px 18px;
    border-radius:var(--radius-sm);
    background:#fff;
    border:1.5px solid var(--line);
    font-size:14px; font-weight:500; color:var(--ink);
    cursor:pointer;
    transition:transform .2s var(--ease), border-color .2s var(--ease),
               background .2s var(--ease), box-shadow .2s var(--ease), color .2s var(--ease);
    user-select:none;
  }
  .chip label:hover{
    transform:translateY(-2px);
    border-color:var(--primary);
  }
  .chip input:checked + label{
    background:var(--primary);
    border-color:var(--primary);
    color:#fff;
    box-shadow:0 10px 22px -10px rgba(25,135,84,0.55);
    transform:translateY(-1px) scale(1.03);
  }
  .chip input:focus-visible + label{
    outline:2px solid var(--primary-dark);
    outline-offset:2px;
  }
  .chip .emoji{ font-size:16px; }

  /* ---- budget ---- */
  .budget-shell{
    background:#fff;
    border:1.5px solid var(--line);
    border-radius:var(--radius-md);
    padding:20px 20px 16px;
  }
  input[type="range"]{
    -webkit-appearance:none;
    width:100%;
    height:6px;
    border-radius:3px;
    background:var(--light-green);
    margin-bottom:16px;
    accent-color:var(--primary);
  }
  input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance:none;
    width:20px; height:20px;
    border-radius:50%;
    background:var(--primary);
    border:3px solid #fff;
    box-shadow:0 4px 10px rgba(23,63,44,0.35);
    cursor:pointer;
    transition:transform .15s var(--ease);
  }
  input[type="range"]::-webkit-slider-thumb:hover{ transform:scale(1.12); }

  .budget-value{
    display:flex; align-items:center; gap:6px;
    font-family:'Fraunces', serif;
    font-size:26px;
    color:var(--primary-dark);
  }
  .budget-value input{
    border:none; outline:none; background:transparent;
    font-family:'Fraunces', serif;
    font-size:26px;
    color:var(--primary-dark);
    width:160px;
  }

  /* ---- submit ---- */
  .submit-row{ margin-top:34px; text-align:center; }

  .generate-btn{
    position:relative;
    display:inline-flex; align-items:center; gap:10px;
    padding:17px 34px;
    border:none;
    border-radius:var(--radius-sm);
    background:linear-gradient(135deg, var(--primary), var(--primary-dark));
    color:#fff;
    font-family:'Inter', sans-serif;
    font-size:16px; font-weight:600;
    cursor:pointer;
    overflow:hidden;
    transition:transform .3s var(--ease), box-shadow .3s var(--ease);
    box-shadow:0 16px 30px -14px rgba(23,63,44,0.55);
  }
  .generate-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 22px 38px -14px rgba(23,63,44,0.6);
  }
  .generate-btn::after{
    content:"";
    position:absolute; top:0; left:-60%;
    width:40%; height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    transform:skewX(-20deg);
    transition:left .6s var(--ease);
  }
  .generate-btn:hover::after{ left:130%; }
  .btn-spark{ animation:pulse 2.4s ease-in-out infinite; }
  .btn-arrow{ transition:transform .25s var(--ease); }
  .generate-btn:hover .btn-arrow{ transform:translateX(4px); }

  /* ============================================================
     5. RESPONSIVE
     ============================================================ */
  @media (max-width: 640px){
    .page{ padding:64px 16px 90px; }
    .planner{ padding:12px 20px 32px; }
    .planner::before{ left:36px; }
    .stop{ gap:14px; }
    .stop-marker{ width:32px; height:32px; font-size:13px; }
    .budget-value input{ width:120px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
  }
</style>
</head>
<body>
  <main class="page">

    <header class="intro">
      <span class="ai-badge"><span class="spark">✦</span> AI Travel Planner</span>
      <h1>Let's design your Maharashtra journey</h1>
      <p class="lede">Tell us where you're starting and what draws you in — forts, coastlines, jungles, or all three. We'll shape an itinerary around it.</p>
    </header>

    <form class="planner" id="plannerForm" action="/plan-trip" method="POST">

      <!-- STOP 1 — WHERE -->
      <section class="stop">
        <div class="stop-marker">1</div>
        <div class="stop-body">
          <label for="start">Where does your journey begin?</label>
          <div class="input-shell">
            <span class="input-icon">📍</span>
            <input type="text" id="start" name="start" placeholder="Pune, Mumbai, Nashik..." autocomplete="off" required>
          </div>
        </div>
      </section>
     
      <!-- STOP 2 — TRAVELLERS -->
<section class="stop">
  <div class="stop-marker">2</div>

  <div class="stop-body">
    <label for="people">
      How many people are travelling?
      <span class="hint">including you</span>
    </label>

    <div class="input-shell">
      <span class="input-icon">👥</span>
      <input
        type="number"
        id="people"
        name="people"
        min="1"
        max="50"
        value="2"
        placeholder="Number of travellers"
        required
      >
    </div>
  </div>
</section>

      <!-- STOP 2 — INTERESTS -->
     <!-- STOP 3 — INTERESTS -->
<section class="stop">
  <div class="stop-marker">3</div>

  <div class="stop-body">
    <label>
      What are you interested in?
      <span class="hint">pick as many as you like</span>
    </label>

    <div class="chip-group">

      <div class="chip">
        <input type="checkbox" id="int-historical" name="interest" value="Historical">
        <label for="int-historical">
          <span class="emoji">🏰</span>Historical
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-religious" name="interest" value="Religious">
        <label for="int-religious">
          <span class="emoji">🛕</span>Religious
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-nature" name="interest" value="Nature">
        <label for="int-nature">
          <span class="emoji">🌿</span>Nature
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-wildlife" name="interest" value="Wildlife">
        <label for="int-wildlife">
          <span class="emoji">🐅</span>Wildlife
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-park" name="interest" value="Park / Garden">
        <label for="int-park">
          <span class="emoji">🌳</span>Park / Garden
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-museum" name="interest" value="Museum">
        <label for="int-museum">
          <span class="emoji">🏛️</span>Museum
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-beach" name="interest" value="Beach">
        <label for="int-beach">
          <span class="emoji">🏖️</span>Beach
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-adventure" name="interest" value="Adventure">
        <label for="int-adventure">
          <span class="emoji">🧗</span>Adventure
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-family" name="interest" value="Family">
        <label for="int-family">
          <span class="emoji">👨‍👩‍👧</span>Family
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-park-family" name="interest" value="Park / Family">
        <label for="int-park-family">
          <span class="emoji">🎡</span>Park / Family
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-leisure" name="interest" value="Leisure">
        <label for="int-leisure">
          <span class="emoji">🌴</span>Leisure
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-trekking" name="interest" value="Trekking">
        <label for="int-trekking">
          <span class="emoji">🥾</span>Trekking
        </label>
      </div>

      <div class="chip">
        <input type="checkbox" id="int-wellness" name="interest" value="Wellness">
        <label for="int-wellness">
          <span class="emoji">🧘</span>Wellness
        </label>
      </div>

    </div>
  </div>
</section>

      <!-- STOP 3 — DURATION -->
      <section class="stop">
        <div class="stop-marker">3</div>
        <div class="stop-body">
          <label>How long is the journey?</label>
          <div class="chip-group">
            <div class="chip">
              <input type="radio" id="days-1" name="days" value="1">
              <label for="days-1">1 Day</label>
            </div>
            <div class="chip">
              <input type="radio" id="days-2" name="days" value="2">
              <label for="days-2">2 Days</label>
            </div>
            <div class="chip">
              <input type="radio" id="days-3" name="days" value="3" checked>
              <label for="days-3">3 Days</label>
            </div>
            <div class="chip">
              <input type="radio" id="days-5" name="days" value="5">
              <label for="days-5">5 Days</label>
            </div>
            <div class="chip">
              <input type="radio" id="days-7" name="days" value="7+">
              <label for="days-7">7+ Days</label>
            </div>
          </div>
        </div>
      </section>

      <!-- STOP 4 — BUDGET -->
      <section class="stop">
        <div class="stop-marker">4</div>
        <div class="stop-body">
          <label for="budgetRange">What's your budget?</label>
          <div class="budget-shell">
            <input type="range" id="budgetRange" min="2000" max="100000" step="500" value="10000" aria-hidden="true" tabindex="-1">
            <div class="budget-value">
              <span>₹</span>
              <input type="number" id="budget" name="budget" min="0" step="500" value="10000">
            </div>
          </div>
        </div>
      </section>

      <!-- STOP 5 — TRAVEL MODE -->
      <section class="stop">
        <div class="stop-marker">5</div>
        <div class="stop-body">
          <label>How will you travel?</label>
          <div class="chip-group">
            <div class="chip">
              <input type="radio" id="travel-car" name="travel" value="Car" checked>
              <label for="travel-car"><span class="emoji">🚗</span>Car</label>
            </div>
            <div class="chip">
              <input type="radio" id="travel-bike" name="travel" value="Bike">
              <label for="travel-bike"><span class="emoji">🏍️</span>Bike</label>
            </div>
            <div class="chip">
              <input type="radio" id="travel-bus" name="travel" value="Bus">
              <label for="travel-bus"><span class="emoji">🚌</span>Bus</label>
            </div>
            <div class="chip">
              <input type="radio" id="travel-train" name="travel" value="Train">
              <label for="travel-train"><span class="emoji">🚆</span>Train</label>
            </div>
          </div>
        </div>
      </section>

      <!-- STOP 6 — SEASON -->
      <section class="stop">
        <div class="stop-marker">6</div>
        <div class="stop-body">
          <label>Best time to go?</label>
          <div class="chip-group">
            <div class="chip">
              <input type="radio" id="season-summer" name="season" value="Summer">
              <label for="season-summer"><span class="emoji">☀️</span>Summer</label>
            </div>
            <div class="chip">
              <input type="radio" id="season-monsoon" name="season" value="Monsoon">
              <label for="season-monsoon"><span class="emoji">🌧️</span>Monsoon</label>
            </div>
            <div class="chip">
              <input type="radio" id="season-winter" name="season" value="Winter">
              <label for="season-winter"><span class="emoji">🍂</span>Winter</label>
            </div>
            <div class="chip">
              <input type="radio" id="season-anytime" name="season" value="Anytime" checked>
              <label for="season-anytime"><span class="emoji">🌍</span>Anytime</label>
            </div>
          </div>
        </div>
      </section>

      <div class="submit-row">
        <button type="submit" class="generate-btn">
          <span class="btn-spark">✦</span>
          <span>Create my trip</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>

    </form>
  </main>

<script>
  // Keep the slider and the number field in sync — the only real
  // interactivity this page needs beyond native checkboxes/radios.
  const range  = document.getElementById('budgetRange');
  const number = document.getElementById('budget');

  range.addEventListener('input', () => { number.value = range.value; });
  number.addEventListener('input', () => {
    const val = Number(number.value) || 0;
    range.value = Math.min(Math.max(val, range.min), range.max);
  });
</script>

</body>
</html>