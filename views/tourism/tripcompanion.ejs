// Helper: Find nearest railway station
function findNearestStation(lat, lon) {
  let nearest = null;
  let minDist = Infinity;
  for (const st of MAHARASHTRA_STATIONS) {
    const d = haversine(lat, lon, st.lat, st.lon);
    if (d < minDist) {
      minDist = d;
      nearest = { ...st, distanceKm: d };
    }
  }
  return nearest;
}

// Helper: Determine origin coordinates
function getOriginCoordinates() {
  if (userLat && userLon) {
    return { lat: userLat, lon: userLon, name: 'Your Location (Live GPS)' };
  }
  if (currentStopIdx > 0) {
    const prev = ALL_STOPS[currentStopIdx - 1];
    if (prev && prev.lat && prev.lon) {
      return { lat: prev.lat, lon: prev.lon, name: prev.place };
    }
  }
  // Lookup starting city
  const cityKey = (STARTING_CITY || 'Pune').toLowerCase().trim();
  const coords = CITY_COORDS[cityKey] || [18.5204, 73.8567];
  return { lat: coords[0], lon: coords[1], name: STARTING_CITY || 'Starting City' };
}

// =======================================================
// ROUTE CALCULATION & MAP DRAWING (OSRM & RAILWAY ENGINE)
// =======================================================
async function fetchAndDrawRoute() {
  if (currentStopIdx >= ALL_STOPS.length) return;
  const currentStop = ALL_STOPS[currentStopIdx];

  // Clear previous route layers
  activeRouteLayers.forEach(layer => {
    if (leafletMap && layer) leafletMap.removeLayer(layer);
  });
  activeRouteLayers = [];

  const origin = getOriginCoordinates();

  if (!currentStop || !currentStop.lat || !currentStop.lon) {
    document.getElementById('routeDistanceText').textContent = 'Unavailable';
    document.getElementById('routeDurationText').textContent = '--';
    document.getElementById('routeAdviceText').innerHTML = 'Exact GPS coordinates unavailable for this stop.';
    document.getElementById('mapsLinkContainer').style.display = 'none';
    return;
  }

  const destLat = currentStop.lat;
  const destLon = currentStop.lon;
  const destName = currentStop.place;

  // Update UI to loading
  document.getElementById('routeDistanceText').innerHTML = '<span class="spinner-border spinner-border-sm text-secondary"></span>';
  document.getElementById('routeDurationText').textContent = 'Calculating...';

  // 1. TRAIN / RAILWAY ROUTING
  if (currentTravelMode === 'train') {
    handleTrainRouting(origin, { lat: destLat, lon: destLon, name: destName });
    return;
  }

  // 2. ROAD ROUTING (BIKE, CAR, WALK) VIA OSRM API
  const osrmProfile = currentTravelMode === 'walk' ? 'foot' : 'driving';
  const osrmUrl = `https://router.project-osrm.org/route/v1/${osrmProfile}/${origin.lon},${origin.lat};${destLon},${destLat}?overview=full&geometries=geojson&steps=true`;

  try {
    if (routeAbortController) {
      routeAbortController.abort();
    }
    routeAbortController = new AbortController();

    const response = await fetch(osrmUrl, { signal: routeAbortController.signal });
    if (!response.ok) throw new Error('OSRM API HTTP ' + response.status);
    const data = await response.json();

    if (data.routes && data.routes.length > 0) {
      const route = data.routes[0];
      const distKm = (route.distance / 1000).toFixed(1);

      // Convert coordinates from GeoJSON [lon, lat] to Leaflet [lat, lon]
      const latlngs = route.geometry.coordinates.map(pt => [pt[1], pt[0]]);

      // Style by mode
      let routeColor = '#ea580c'; // Bike orange
      let routeWeight = 6;
      let routeDash = null;

      if (currentTravelMode === 'car') {
        routeColor = '#0284c7';
      } else if (currentTravelMode === 'walk') {
        routeColor = '#16a34a';
        routeWeight = 5;
        routeDash = '6, 6';
      }

      // Draw polyline
      const polyline = L.polyline(latlngs, {
        color: routeColor,
        weight: routeWeight,
        opacity: 0.85,
        dashArray: routeDash,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(leafletMap);
      activeRouteLayers.push(polyline);

      // Travel Time Calculations
      let etaMinutes = 0;
      if (currentTravelMode === 'bike') {
        // Average bike speed ~48 km/h in Maharashtra + ghat turns
        etaMinutes = Math.max(5, Math.round((Number(distKm) / 48) * 60));
      } else if (currentTravelMode === 'car') {
        etaMinutes = Math.max(5, Math.round((Number(distKm) / 62) * 60));
      } else {
        etaMinutes = Math.max(5, Math.round((Number(distKm) / 4.5) * 60));
      }

      const hrs = Math.floor(etaMinutes / 60);
      const mins = etaMinutes % 60;
      const durationText = hrs > 0 ? `${hrs} hr ${mins} mins` : `${mins} mins`;

      document.getElementById('routeDistanceText').textContent = `${distKm} km`;
      document.getElementById('routeDurationText').textContent = durationText;

      // Best Route Guidance
      let adviceHtml = '';
      if (currentTravelMode === 'bike') {
        adviceHtml = `
          <strong>🏍️ Recommended Bike Route:</strong> Direct scenic highway route from ${origin.name} to ${destName}. 
          The state highway and old highway routes (Old NH48/SH) offer smooth two-wheeler cruising with scenic vistas. 
          Ride at moderate speeds on ghat hairpins. <em>(Helmet & protective riding gear mandatory)</em>
        `;
      } else if (currentTravelMode === 'car') {
        adviceHtml = `
          <strong>🚗 Recommended Car Route:</strong> Expressways and primary national highways from ${origin.name} to ${destName}. 
          Keep FASTag active for toll plazas and maintain safe braking distance on ghat declines.
        `;
      } else {
        adviceHtml = `
          <strong>🚶 Walking / Trekking Route:</strong> Follow designated footpaths and walking trails from ${origin.name} to ${destName}. 
          Stay hydrated and wear sturdy trail footwear.
        `;
      }
      document.getElementById('routeAdviceText').innerHTML = adviceHtml;

      // Update Google Maps button
      updateGoogleMapsButton(origin, { lat: destLat, lon: destLon }, currentTravelMode);

      // Fit bounds
      fitRouteBounds();
    } else {
      throw new Error('No route returned by OSRM');
    }
  } catch (err) {
    if (err.name === 'AbortError') return;
    console.warn('OSRM route fetch fallback to straight-line:', err);
    fallbackDirectRoute(origin, { lat: destLat, lon: destLon, name: destName }, currentTravelMode);
  }
}

// Fallback when offline or OSRM unavailable
function fallbackDirectRoute(origin, dest, mode) {
  const straightDist = haversine(origin.lat, origin.lon, dest.lat, dest.lon);
  const roadDist = (straightDist * 1.3).toFixed(1); // Standard winding factor

  let speed = mode === 'bike' ? 45 : (mode === 'car' ? 60 : 4.5);
  const totalMins = Math.round((Number(roadDist) / speed) * 60);
  const hrs = Math.floor(totalMins / 60);
  const mins = totalMins % 60;
  const durTxt = hrs > 0 ? `${hrs} hr ${mins} mins` : `${mins} mins`;

  document.getElementById('routeDistanceText').textContent = `~${roadDist} km`;
  document.getElementById('routeDurationText').textContent = durTxt;

  // Simple direct line with dash
  const color = mode === 'bike' ? '#ea580c' : (mode === 'car' ? '#0284c7' : '#16a34a');
  const line = L.polyline([[origin.lat, origin.lon], [dest.lat, dest.lon]], {
    color: color, weight: 4, opacity: 0.8, dashArray: '8, 8'
  }).addTo(leafletMap);
  activeRouteLayers.push(line);

  document.getElementById('routeAdviceText').innerHTML = `
    <strong>${mode === 'bike' ? '🏍️ Bike' : '🚗 Vehicle'} Route:</strong> Direct roadway from ${origin.name} to ${dest.name} (Estimated road distance: ~${roadDist} km). 
    Use the Google Maps button below to start turn-by-turn navigation.
  `;

  updateGoogleMapsButton(origin, dest, mode);
  fitRouteBounds();
}

// Handle Train / Railway Routing
function handleTrainRouting(origin, dest) {
  const stOrigin = findNearestStation(origin.lat, origin.lon);
  const stDest = findNearestStation(dest.lat, dest.lon);

  if (!stOrigin || !stDest) {
    document.getElementById('routeDistanceText').textContent = '--';
    document.getElementById('routeDurationText').textContent = '--';
    document.getElementById('routeAdviceText').innerHTML = 'Nearest railway station could not be determined.';
    return;
  }

  const dToOriginStation = haversine(origin.lat, origin.lon, stOrigin.lat, stOrigin.lon);
  const railDistance = haversine(stOrigin.lat, stOrigin.lon, stDest.lat, stDest.lon) * 1.25;
  const dFromDestStation = haversine(stDest.lat, stDest.lon, dest.lat, dest.lon);
  const totalDist = (dToOriginStation + railDistance + dFromDestStation).toFixed(1);

  // Train travel time @ approx 52 km/h
  const trainMins = Math.max(15, Math.round((railDistance / 52) * 60));
  const hrs = Math.floor(trainMins / 60);
  const mins = trainMins % 60;
  const trainTimeTxt = hrs > 0 ? `${hrs} hr ${mins} mins` : `${mins} mins`;

  document.getElementById('routeDistanceText').textContent = `${totalDist} km`;
  document.getElementById('routeDurationText').textContent = trainTimeTxt;

  // Draw 3 segments on map:
  // 1. Origin to StOrigin (dashed road)
  const leg1 = L.polyline([[origin.lat, origin.lon], [stOrigin.lat, stOrigin.lon]], {
    color: '#0d6efd', weight: 4, opacity: 0.8, dashArray: '6, 6'
  }).addTo(leafletMap);
  activeRouteLayers.push(leg1);

  // 2. StOrigin to StDest (Railway track: dual line styling)
  const railBase = L.polyline([[stOrigin.lat, stOrigin.lon], [stDest.lat, stDest.lon]], {
    color: '#1e293b', weight: 6, opacity: 0.9
  }).addTo(leafletMap);
  activeRouteLayers.push(railBase);

  const railDashes = L.polyline([[stOrigin.lat, stOrigin.lon], [stDest.lat, stDest.lon]], {
    color: '#ffffff', weight: 4, opacity: 0.9, dashArray: '8, 8'
  }).addTo(leafletMap);
  activeRouteLayers.push(railDashes);

  // 3. StDest to Destination spot (dashed green)
  const leg3 = L.polyline([[stDest.lat, stDest.lon], [dest.lat, dest.lon]], {
    color: '#198754', weight: 4, opacity: 0.8, dashArray: '6, 6'
  }).addTo(leafletMap);
  activeRouteLayers.push(leg3);

  // Add station icons on map
  const stIcon = L.divIcon({
    html: '<div style="background:#4f46e5;color:white;border-radius:8px;padding:3px 7px;font-size:11px;font-weight:bold;border:2px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3);white-space:nowrap;">🚉 Rail</div>',
    className: '', iconSize: [40, 20], iconAnchor: [20, 10]
  });
  const m1 = L.marker([stOrigin.lat, stOrigin.lon], { icon: stIcon }).bindPopup(`<strong>Boarding Station:</strong> ${stOrigin.name}`);
  const m2 = L.marker([stDest.lat, stDest.lon], { icon: stIcon }).bindPopup(`<strong>Arrival Station:</strong> ${stDest.name}`);
  m1.addTo(leafletMap);
  m2.addTo(leafletMap);
  activeRouteLayers.push(m1, m2);

  // Advice & Station info text
  document.getElementById('routeAdviceText').innerHTML = `
    <strong>🚆 Rail Transit Route:</strong> Travel from ${origin.name} to <strong>${stOrigin.name}</strong>. 
    Board an express or local train to <strong>${stDest.name}</strong>. From ${stDest.name}, take local transport (${dFromDestStation.toFixed(1)} km) to reach ${dest.name}.
  `;

  document.getElementById('trainStationsText').innerHTML = `
    <div><strong>1. Boarding Station:</strong> ${stOrigin.name} (${dToOriginStation.toFixed(1)} km away)</div>
    <div><strong>2. Destination Station:</strong> ${stDest.name}</div>
    <div><strong>3. Station to Destination:</strong> ${dFromDestStation.toFixed(1)} km (local taxi/auto/bus available)</div>
  `;

  updateGoogleMapsButton(origin, dest, 'train');
  fitRouteBounds();
}

// Update Google Maps button URL and text based on mode
function updateGoogleMapsButton(origin, dest, mode) {
  const mapsLink = document.getElementById('mapsNavLink');
  const mapsLabel = document.getElementById('mapsNavLabel');
  if (!mapsLink) return;

  const gmapsMode = mode === 'bike' ? 'two_wheeler' : (mode === 'train' ? 'transit' : (mode === 'walk' ? 'walking' : 'driving'));
  const url = `https://www.google.com/maps/dir/?api=1&origin=${origin.lat},${origin.lon}&destination=${dest.lat},${dest.lon}&travelmode=${gmapsMode}`;

  mapsLink.href = url;

  const labels = {
    'bike': '🏍️ Start Bike Navigation in Google Maps (Two-Wheeler Mode)',
    'train': '🚆 View Train Timetable & Route in Google Maps (Transit Mode)',
    'car': '🚗 Start Car Navigation in Google Maps (Driving Mode)',
    'walk': '🚶 Start Walking Directions in Google Maps (Walking Mode)'
  };
  if (mapsLabel) {
    mapsLabel.textContent = labels[mode] || 'Open in Google Maps';
  }
  document.getElementById('mapsLinkContainer').style.display = 'block';
}

// Fit map bounds to show full route and stops
function fitRouteBounds() {
  if (!leafletMap) return;
  const pts = [];

  // Add origin & dest
  const origin = getOriginCoordinates();
  if (origin && origin.lat && origin.lon) pts.push([origin.lat, origin.lon]);

  if (currentStopIdx < ALL_STOPS.length) {
    const st = ALL_STOPS[currentStopIdx];
    if (st.lat && st.lon) pts.push([st.lat, st.lon]);
  }

  // Also include route coordinates if any
  activeRouteLayers.forEach(layer => {
    if (layer.getLatLngs) {
      const lls = layer.getLatLngs();
      if (Array.isArray(lls)) {
        lls.forEach(pt => {
          if (pt.lat && pt.lng) pts.push([pt.lat, pt.lng]);
        });
      }
    }
  });

  if (pts.length > 0) {
    leafletMap.fitBounds(pts, { padding: [45, 45], maxZoom: 15 });
  }
}

// =======================================================
// GPS LOCATION TRACKING
// =======================================================
function requestLocationPermission() {
  if (!navigator.geolocation) {
    showGPSError('Geolocation is not supported by your browser.');
    return;
  }
  document.getElementById('enableLocationBtn').disabled = true;
  document.getElementById('enableLocationBtn').innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Requesting…';

  gpsWatchId = navigator.geolocation.watchPosition(
    onLocationSuccess,
    onLocationError,
    { enableHighAccuracy: true, maximumAge: 15000, timeout: 15000 }
  );
}

function onLocationSuccess(position) {
  userLat = position.coords.latitude;
  userLon = position.coords.longitude;
  const acc = position.coords.accuracy ? position.coords.accuracy.toFixed(0) : 'N/A';

  document.getElementById('locationConsentBox').style.display = 'none';
  document.getElementById('enableLocationBtn').style.display = 'none';
  document.getElementById('disableLocationBtn').style.display = 'flex';
  document.getElementById('gpsBadge').className = 'safety-status-pill pill-active';
  document.getElementById('gpsBadge').innerHTML = '<span class="gps-dot active" id="gpsDot"></span> GPS Active';
  document.getElementById('gpsCoords').textContent = `${userLat.toFixed(5)}°N, ${userLon.toFixed(5)}°E`;
  document.getElementById('gpsAccuracy').textContent = `Accuracy: ±${acc}m`;

  // Update user marker on map
  if (leafletMap) {
    const userIcon = L.divIcon({
      html: '<div style="background:#0d6efd;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 0 0 5px rgba(13,110,253,0.35);"></div>',
      className: '', iconSize: [16, 16], iconAnchor: [8, 8]
    });
    if (userMarker) { leafletMap.removeLayer(userMarker); }
    userMarker = L.marker([userLat, userLon], { icon: userIcon })
      .bindPopup('<strong>Your Location (Live GPS)</strong>')
      .addTo(leafletMap);
  }

  // Recalculate route with live GPS location
  fetchAndDrawRoute();

  // Load weather for current location if first time
  if (!window._weatherLoadedForCurrentLoc) {
    window._weatherLoadedForCurrentLoc = true;
    loadWeatherForCoords(userLat, userLon, 'Your Current Location');
  }
}

function onLocationError(err) {
  document.getElementById('enableLocationBtn').disabled = false;
  document.getElementById('enableLocationBtn').innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Enable Location';
  const msgs = {
    1: 'Location access denied. Please allow location access in your browser settings.',
    2: 'Location unavailable. Make sure GPS is enabled on your device.',
    3: 'Location request timed out. Please try again.'
  };
  showGPSError(msgs[err.code] || 'Unable to get location.');
}

function showGPSError(msg) {
  document.getElementById('gpsCoords').textContent = msg;
  document.getElementById('gpsCoords').style.color = '#dc3545';
}

function stopLocationTracking() {
  if (gpsWatchId !== null) {
    navigator.geolocation.clearWatch(gpsWatchId);
    gpsWatchId = null;
  }
  userLat = null; userLon = null;
  document.getElementById('enableLocationBtn').style.display = 'flex';
  document.getElementById('enableLocationBtn').disabled = false;
  document.getElementById('enableLocationBtn').innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Enable Location';
  document.getElementById('disableLocationBtn').style.display = 'none';
  document.getElementById('gpsBadge').className = 'safety-status-pill pill-inactive';
  document.getElementById('gpsBadge').innerHTML = '<span class="gps-dot inactive"></span> GPS Off';
  document.getElementById('gpsCoords').textContent = 'Location tracking stopped.';
  document.getElementById('gpsCoords').style.color = '#aaa';
  document.getElementById('gpsAccuracy').textContent = '';
  document.getElementById('locationConsentBox').style.display = 'block';
  if (userMarker && leafletMap) { leafletMap.removeLayer(userMarker); userMarker = null; }
  window._weatherLoadedForCurrentLoc = false;

  // Redraw route from starting city
  fetchAndDrawRoute();
}

// =======================================================
// STOP NAVIGATION
// =======================================================
function goToStop(idx) {
  if (idx < 0 || idx >= ALL_STOPS.length) return;
  currentStopIdx = idx;
  const stop = ALL_STOPS[idx];

  // Auto-detect transport mode if defined on stop
  if (stop.transportMode) {
    const t = stop.transportMode.toLowerCase();
    if (t.includes('bike') || t.includes('motorcycle') || t.includes('scooter') || t.includes('बाईक')) {
      setTravelMode('bike');
    } else if (t.includes('train') || t.includes('rail') || t.includes('ट्रेन') || t.includes('रेल्वे')) {
      setTravelMode('train');
    } else if (t.includes('car') || t.includes('cab') || t.includes('taxi') || t.includes('drive') || t.includes('कार')) {
      setTravelMode('car');
    } else if (t.includes('walk') || t.includes('trek') || t.includes('पायी')) {
      setTravelMode('walk');
    }
  }

  // Update header
  document.getElementById('currentDestName').textContent = stop.place;
  document.getElementById('currentDestMeta').textContent =
    `${stop.dayLabel}${stop.arrivalTime ? ' · ' + stop.arrivalTime : ''} · ${stop.type}`;

  // Update marker colours
  stopMarkers.forEach((m, i) => {
    const el = m.getElement();
    if (!el) return;
    const div = el.querySelector('div');
    if (div) div.style.background = i === idx ? '#dc3545' : '#198754';
  });

  // Update prev/next buttons
  document.getElementById('prevStopBtn').disabled = idx === 0;
  document.getElementById('nextStopBtn').disabled = idx >= ALL_STOPS.length - 1;

  // Update all stops highlight
  document.querySelectorAll('[id^="stop-num-"]').forEach((el, i) => {
    el.classList.remove('active');
    if (i === idx) el.classList.add('active');
  });

  // Recalculate route and redraw
  fetchAndDrawRoute();

  // Save progress
  saveProgress();
}

function markCurrentArrived() {
  const stop = ALL_STOPS[currentStopIdx];
  if (!stop) return;
  markStopDone(currentStopIdx, stop.activityId);
}

function markStopDone(si, activityId) {
  if (COMPLETED_IDS.includes(activityId)) return;

  if (!confirm(`Mark "${ALL_STOPS[si].place}" as visited?`)) return;

  COMPLETED_IDS.push(activityId);

  // Update UI
  const numEl = document.getElementById(`stop-num-${si}`);
  if (numEl) { numEl.classList.remove('active'); numEl.classList.add('done'); numEl.textContent = '✓'; }

  const doneBtn = document.getElementById(`done-btn-${si}`);
  if (doneBtn) {
    doneBtn.outerHTML = '<span style="font-size:11px; color:var(--tc-green); font-weight:700;">✅ Visited</span>';
  }

  // Save to server
  fetch(`/my-trips/${TRIP_ID}/progress`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      currentDayIndex: ALL_STOPS[si].dayIndex,
      currentActivityIndex: ALL_STOPS[si].activityIndex,
      completedActivityId: activityId
    })
  }).catch(console.error);

  // Move to next stop automatically
  if (si < ALL_STOPS.length - 1) {
    setTimeout(() => goToStop(si + 1), 500);
  } else {
    document.getElementById('completeTripBtn').style.animation = 'pulse 1s 3';
  }
}

// =======================================================
// HAVERSINE DISTANCE (km)
// =======================================================
function haversine(lat1, lon1, lat2, lon2) {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

// =======================================================
// SAFETY MONITORING + GEOFENCING
// =======================================================
function startSafetyMonitoring() {
  if (!navigator.geolocation) {
    alert('Geolocation is not supported by your browser.');
    return;
  }
  document.getElementById('startMonitoringBtn').disabled = true;
  document.getElementById('stopMonitoringBtn').disabled = false;
  document.getElementById('monitoringStatusBadge').className = 'safety-status-pill pill-active';
  document.getElementById('monitoringStatusBadge').innerHTML = '<span class="gps-dot active" id="monDot"></span> Monitoring Active';
  document.getElementById('gfEmptyState').style.display = 'none';
  isMonitoring = true;

  safetyWatchId = navigator.geolocation.watchPosition(
    (pos) => {
      const lat = pos.coords.latitude;
      const lon = pos.coords.longitude;
      const acc = pos.coords.accuracy;
      const ts = new Date().toLocaleTimeString();
      document.getElementById('gpsStatusLine').textContent = `📡 Last update: ${ts} · ±${acc ? acc.toFixed(0) : '?'}m accuracy`;
      checkGeofences(lat, lon);
      // Also update user location
      onLocationSuccess(pos);
    },
    (err) => {
      const msgs = {1:'Location denied.',2:'Location unavailable.',3:'Timeout.'};
      document.getElementById('gpsStatusLine').textContent = `⚠️ GPS Error: ${msgs[err.code] || 'Unknown error.'}`;
      stopSafetyMonitoring();
    },
    { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 }
  );

  // Load geofences from server
  fetch('/api/safety/geofences', { credentials: 'include' })
    .then(r => r.json())
    .then(data => {
      if (data.success && data.zones) {
        allGeofences = data.zones.filter(z => typeof z.latitude === 'number' && typeof z.longitude === 'number');
      } else if (Array.isArray(data)) {
        allGeofences = data.filter(z => typeof z.latitude === 'number' && typeof z.longitude === 'number');
      }
    })
    .catch(e => console.error('Geofence load failed:', e));
}

function stopSafetyMonitoring() {
  if (safetyWatchId !== null) {
    navigator.geolocation.clearWatch(safetyWatchId);
    safetyWatchId = null;
  }
  isMonitoring = false;
  zoneState = {};
  document.getElementById('startMonitoringBtn').disabled = false;
  document.getElementById('stopMonitoringBtn').disabled = true;
  document.getElementById('monitoringStatusBadge').className = 'safety-status-pill pill-inactive';
  document.getElementById('monitoringStatusBadge').innerHTML = '<span class="gps-dot inactive"></span> Stopped';
  document.getElementById('gpsStatusLine').textContent = 'Monitoring stopped.';
}

const HYSTERESIS = 1.15; // 15% buffer to prevent boundary flickering

function checkGeofences(lat, lon) {
  if (!allGeofences || allGeofences.length === 0) return;
  const logEl = document.getElementById('gfAlertLog');

  allGeofences.forEach(zone => {
    const distKm = haversine(lat, lon, zone.latitude, zone.longitude);
    const distM = distKm * 1000;
    const radius = zone.radius || 400;
    const prev = zoneState[zone.id] || false;
    const inside = distM <= radius;
    const exitThreshold = radius * HYSTERESIS;
    const exitZone = distM > exitThreshold;

    if (inside && !prev) {
      zoneState[zone.id] = true;
      addGeofenceAlert(logEl, zone, distM, 'enter');
    } else if (exitZone && prev) {
      zoneState[zone.id] = false;
      addGeofenceAlert(logEl, zone, distM, 'exit');
    }
  });
}

function addGeofenceAlert(logEl, zone, distM, eventType) {
  const gfEmptyState = document.getElementById('gfEmptyState');
  if (gfEmptyState) gfEmptyState.style.display = 'none';

  const isRestricted = zone.status === 'verified' && (zone.zoneType === 'restricted_area' || zone.zoneType === 'caution_zone');
  const alertClass = eventType === 'exit' ? 'gf-exit' : (isRestricted ? 'gf-restricted' : (zone.zoneType === 'caution_zone' ? 'gf-caution' : 'gf-enter'));
  const icon = eventType === 'exit' ? '🚶' : (isRestricted ? '⚠️' : '📍');
  const label = eventType === 'enter'
    ? (isRestricted ? 'Entering verified restricted zone' : 'Entering tourist zone')
    : 'Exited zone';

  const verifiedBadge = (zone.status === 'verified') ? '<span style="background:#dc3545;color:white;font-size:10px;padding:1px 6px;border-radius:10px;margin-left:4px;">VERIFIED</span>' : '<span style="background:#ddd;color:#555;font-size:10px;padding:1px 6px;border-radius:10px;margin-left:4px;">INFORMATIONAL</span>';

  const div = document.createElement('div');
  div.className = `gf-alert ${alertClass}`;
  div.innerHTML = `
    <div>
      <div style="font-weight:800; margin-bottom:3px;">${icon} ${zone.name || zone.title} ${verifiedBadge}</div>
      <div style="font-size:11px;">${label} · ${distM < 1000 ? distM.toFixed(0)+'m' : (distM/1000).toFixed(1)+'km'} away</div>
      ${zone.zoneType ? `<div style="font-size:11px; opacity:0.8;">Zone type: ${zone.zoneType}</div>` : ''}
      ${isRestricted && zone.restrictedReason ? `<div style="font-size:11px; color:inherit; margin-top:3px;">ℹ️ ${zone.restrictedReason}</div>` : ''}
      <div style="font-size:10px; color:#888; margin-top:3px;">This is an informational alert. Always verify with local authorities for official restrictions.</div>
    </div>
    <button onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:14px;color:inherit;opacity:0.5;padding:0 4px;">✕</button>
  `;
  logEl.insertBefore(div, logEl.firstChild);
}

// =======================================================
// WEATHER
// =======================================================
function loadWeatherForStop(tabIndex, btn) {
  document.querySelectorAll('.dest-weather-tab').forEach(t => t.classList.remove('active'));
  if (btn) btn.classList.add('active');

  if (tabIndex === 0) {
    // Current location
    if (userLat && userLon) {
      loadWeatherForCoords(userLat, userLon, 'Your Current Location');
    } else {
      document.getElementById('weatherDisplay').innerHTML = `
        <div class="weather-loading">
          <i class="fa-solid fa-location-crosshairs me-1"></i> Enable your location first to see current weather.
        </div>`;
    }
    return;
  }

  // Destination tabs
  const lat = btn ? parseFloat(btn.dataset.lat) : null;
  const lon = btn ? parseFloat(btn.dataset.lon) : null;
  const name = btn ? btn.dataset.name : 'Destination';
  if (!lat || !lon || isNaN(lat) || isNaN(lon)) {
    document.getElementById('weatherDisplay').innerHTML = '<div class="weather-error">No coordinates for this destination.</div>';
    return;
  }
  loadWeatherForCoords(lat, lon, name);
}

const weatherCache = {};

function loadWeatherForCoords(lat, lon, label) {
  const key = `${lat.toFixed(3)},${lon.toFixed(3)}`;
  if (weatherCache[key] && (Date.now() - weatherCache[key].ts < 10 * 60 * 1000)) {
    renderWeather(weatherCache[key].data, label);
    return;
  }

  document.getElementById('weatherDisplay').innerHTML = `
    <div class="weather-loading"><i class="fa-solid fa-spinner fa-spin me-1"></i> Loading weather for ${label}…</div>`;

  fetch(`/api/trips/weather?lat=${lat}&lon=${lon}`, { credentials: 'include' })
    .then(r => r.json())
    .then(data => {
      weatherCache[key] = { data, ts: Date.now() };
      renderWeather(data, label);
    })
    .catch(err => {
      document.getElementById('weatherDisplay').innerHTML = `
        <div class="weather-error">
          <i class="fa-solid fa-cloud-slash me-1"></i> Weather data unavailable.<br>
          <button onclick="loadWeatherForCoords(${lat},${lon},'${label}')" style="background:none;border:none;color:var(--tc-blue);cursor:pointer;font-size:13px;font-weight:700;margin-top:6px;">Retry</button>
        </div>`;
    });
}

function renderWeather(data, label) {
  if (!data.success) {
    document.getElementById('weatherDisplay').innerHTML = `<div class="weather-error">${data.error || 'Weather unavailable.'}</div>`;
    return;
  }

  const cur = data.current;
  const daily = data.daily || [];
  const warnings = data.warnings || [];

  let warningHtml = '';
  warnings.forEach(w => {
    const cls = w.level === 'danger' ? 'danger' : 'warning';
    warningHtml += `<div class="alert alert-${cls} py-2 px-3 mb-2 rounded-3 small">${w.text}</div>`;
  });

  let curHtml = '';
  if (cur) {
    curHtml = `
      <div class="weather-card">
        <div class="d-flex align-items-center gap-3 mb-2">
          <div class="weather-icon">${cur.icon}</div>
          <div>
            <div class="weather-temp">${cur.temperature}°C</div>
            <div style="font-weight:700; color:#183c2c;">${cur.description}</div>
            <div class="weather-detail">${label}</div>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:8px; font-size:12px; color:#555;">
          <div>🌡️ Feels like<br><strong>${cur.feelsLike}°C</strong></div>
          <div>💧 Humidity<br><strong>${cur.humidity}%</strong></div>
          <div>💨 Wind<br><strong>${cur.windSpeed} km/h</strong></div>
          ${cur.precipitation > 0 ? `<div>🌧️ Precipitation<br><strong>${cur.precipitation} mm</strong></div>` : ''}
        </div>
        <div style="font-size:10px; color:#aaa; margin-top:8px;">Data from Open-Meteo · ${cur.time || ''} · ${data.timezone || ''}</div>
      </div>`;
  }

  let forecastHtml = '';
  daily.slice(0, 4).forEach(d => {
    forecastHtml += `
      <div style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid #f0f5f0;">
        <div style="font-size:1.4rem;">${d.icon}</div>
        <div style="flex:1;">
          <div style="font-weight:700; font-size:13px;">${d.date}</div>
          <div style="font-size:12px; color:#888;">${d.description}</div>
        </div>
        <div style="text-align:right; font-size:12px;">
          <div style="font-weight:800;">${d.maxTemp}°C</div>
          <div style="color:#aaa;">${d.minTemp}°C</div>
          ${d.precipitationProb > 20 ? `<div style="color:#0d6efd;">🌧️ ${d.precipitationProb}%</div>` : ''}
        </div>
      </div>`;
  });

  document.getElementById('weatherDisplay').innerHTML = `
    ${warningHtml}
    ${curHtml || '<div class="weather-error">Current conditions unavailable.</div>'}
    ${daily.length > 0 ? `<div style="margin-top:12px; font-weight:700; font-size:13px; color:#555; margin-bottom:6px;">7-Day Forecast</div>${forecastHtml}` : ''}
  `;
}

// =======================================================
// TRIP PROGRESS PERSISTENCE
// =======================================================
function saveProgress() {
  if (progressSaveTimer) clearTimeout(progressSaveTimer);
  progressSaveTimer = setTimeout(() => {
    const stop = ALL_STOPS[currentStopIdx] || ALL_STOPS[0];
    if (!stop) return;
    fetch(`/my-trips/${TRIP_ID}/progress`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        currentDayIndex: stop.dayIndex,
        currentActivityIndex: stop.activityIndex,
        tripStatus: 'in_progress'
      })
    }).catch(console.error);
  }, 2000);
}

function pauseTrip() {
  if (!confirm('Pause this trip? You can resume it later from My Trips.')) return;
  fetch(`/my-trips/${TRIP_ID}/progress`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tripStatus: 'paused' })
  }).then(() => {
    stopLocationTracking();
    stopSafetyMonitoring();
    window.location.href = '/my-trips';
  }).catch(console.error);
}

function confirmCompleteTrip() {
  const totalStops = ALL_STOPS.length;
  const done = COMPLETED_IDS.length;
  if (totalStops > 0 && done < totalStops) {
    if (!confirm(`You have completed ${done} of ${totalStops} stops. Mark the trip as finished anyway?`)) return;
  } else {
    if (!confirm('Mark this trip as completed? This action cannot be undone.')) return;
  }
  fetch(`/my-trips/${TRIP_ID}/complete`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  }).then(r => r.json()).then(data => {
    if (data.success) {
      stopLocationTracking();
      stopSafetyMonitoring();
      alert('🎉 Trip completed! Well done on your Maharashtra adventure!');
      window.location.href = '/my-trips';
    }
  }).catch(console.error);
}

// =======================================================
// SOS MODAL
// =======================================================
function openSOSModal() {
  document.getElementById('sosModalOverlay').classList.add('open');
  document.getElementById('sosResult').style.display = 'none';
  document.getElementById('sosFormSection').style.display = 'block';
}

function closeSOSModal() {
  document.getElementById('sosModalOverlay').classList.remove('open');
}

document.getElementById('sosLocationConsent').addEventListener('change', function() {
  document.getElementById('sosLocationNote').style.display = this.checked ? 'block' : 'none';
});

async function submitSOSReport() {
  const type = document.getElementById('sosType').value;
  const desc = document.getElementById('sosDescription').value.trim();
  const phone = document.getElementById('sosPhone').value.trim();
  const consent = document.getElementById('sosLocationConsent').checked;

  if (!type) { alert('Please select an incident type.'); return; }
  if (desc.length < 5) { alert('Please provide a description of at least 5 characters.'); return; }

  const submitBtn = document.getElementById('sosSubmitBtn');
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Submitting…';

  const payload = { incidentType: type, description: desc, locationConsent: consent };
  if (phone) payload.userPhone = phone;

  // If consent given, try to get fresh location
  if (consent) {
    try {
      const pos = await new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 8000, enableHighAccuracy: true });
      });
      payload.latitude = pos.coords.latitude;
      payload.longitude = pos.coords.longitude;
      payload.accuracy = pos.coords.accuracy;
    } catch (e) {
      // Could not get fresh location — proceed without coordinates
      payload.locationConsent = false;
    }
  }

  try {
    const res = await fetch('/incidents', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (data.success) {
      document.getElementById('sosRefId').textContent = data.reportId || 'N/A';
      document.getElementById('sosFormSection').style.display = 'none';
      document.getElementById('sosResult').style.display = 'block';
    } else {
      alert(`Error: ${data.error || 'Failed to submit report.'}`);
    }
  } catch (err) {
    alert('Network error. Please try again or call 112 directly.');
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> Submit Report';
  }
}

// Close modal on overlay click
document.getElementById('sosModalOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeSOSModal();
});

// Stop tracking on page unload
window.addEventListener('beforeunload', () => {
  if (gpsWatchId !== null) navigator.geolocation.clearWatch(gpsWatchId);
  if (safetyWatchId !== null) navigator.geolocation.clearWatch(safetyWatchId);
});

// =======================================================
// INIT
// =======================================================
document.addEventListener('DOMContentLoaded', () => {
  initMap();

  // Set initial stop (restore from progress or start at 0)
  const savedDayIdx = <%= currentDayIdx %>;
  // Find first non-completed stop matching saved day index
  let startStopIdx = 0;
  for (let i = 0; i < ALL_STOPS.length; i++) {
    if (ALL_STOPS[i].dayIndex === savedDayIdx && !COMPLETED_IDS.includes(ALL_STOPS[i].activityId)) {
      startStopIdx = i;
      break;
    }
  }
  // Also find first uncompleted stop overall
  const firstUndone = ALL_STOPS.findIndex(s => !COMPLETED_IDS.includes(s.activityId));
  if (firstUndone >= 0) startStopIdx = firstUndone;

  goToStop(startStopIdx);

  // Load weather tabs for first stop with coords
  const firstWithCoords = ALL_STOPS.find(s => s.lat && s.lon);
  if (firstWithCoords) {
    const tabs = document.querySelectorAll('.dest-weather-tab');
    if (tabs.length > 1) {
      // Default tab is "Current Location" — weather will load when GPS is enabled
    }
  }
});
</script>
