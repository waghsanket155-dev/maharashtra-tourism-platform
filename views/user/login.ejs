<% layout ("layout/boilerplate")%>

<style>
   .main {
    width: 100vw;
    min-height: calc(100vh - 140px);

    margin-left: calc(50% - 50vw);
    padding: 40px;
    background-image: url("https://wallpaperaccess.com/full/11738598.png");
    background-size: cover;
    background-position: center;

    box-sizing: border-box;

    display: flex;
    justify-content: center;
    align-items: center;
}
.login-box {
    position: relative;
    border: 2px solid rgba(255, 255, 255, .5);
    background: transparent;
    height: 400px;
    width: 400px;              /* 400px → 350px */
    padding: 30px;             /* Inner spacing */
    backdrop-filter: blur(20px);
    box-shadow: 0 0 30px rgba(0,0,0,.5);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

.login-box form {
    width: 100%;
}
.login-box h2{
    font-size: 2rem;
    color: #162938;
    text-align: center;
    position: absolute;
    top: 20px;
    
}
.info-a{
    position: relative;
    width: 100%;
    height: 50px;
    border-bottom: 2px solid #162938;
    margin: 30px 0;
}
.info-a label{
    position: absolute;
    top: 50%;
    left: 35px;
    transform: translate(-50%);
    font-size: 1em;
    color: #162938;
    font-weight: 500;
    pointer-events: none;
}
.info-a input{
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1em;
    color: #162938;
    font-weight: 600;
    padding: 0 35px 0 5px;
}
.info-a .logo{
    position: absolute;
    right: 8px;
    font-size:1.2em ;
    color: #162938;
    line-height: 57px;
}
.info-a input:focus~label,
.info-a input:valid~label{
    top: -7px;
}
#forgot{
    font-size: .9em;
    color: #162938;
    font-weight:500 ;
    margin: -15px 0 15px;
    display: flex;
    justify-content: space-between;
}
#forgot label input{
    accent-color: #162938;
    margin-right: 3px;
}
#forgot a{
    text-decoration: none;
    color: black;
}
#forgot a:hover{
    text-decoration: underline;
}
.yes{
    width: 100%;
    height: 45px;
    background: #162938;
    border: none;
    outline: none;
    z-index: 10;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1em;
    color: #fff;
    font-weight: 500
}
.register{
    font-size: .9em;
    color: #162938;
    text-align: center;
    font-weight: 500;
    margin: 25px 0 10px;
}
.register p a{
    color: #000;
    text-decoration: none;
    font-weight: 600;
}
.register p a:hover{
    text-decoration: underline;
}
/* Prevent Bootstrap validation from changing custom input design */

.info-a input,
.info-a input:focus,
.info-a input:valid,
.info-a input:invalid {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    background-image: none !important;
}
html,
body {
    overflow-x: hidden;
}
</style>
<div class="main">

    <div class="login-box">

        <h2>Login</h2>

        <form action="/login" method="POST"  class="needs-validation" novalidate>

            <div class="info-a">
                <span class="logo"><i class="fa-solid fa-circle-user"></i></span>
                <input type="text" name="username"  id="user" class="form-control"  required>
                <label for="user" class="form-label" >Username</label>
            </div>

            <div class="info-a">
                <span class="logo"><i class="fa-solid fa-lock"></i></span>
                <input type="password" name="password" id="password"  class="form-control"  required>
                <label for="password"  class="form-label">Password</label>
            </div>

            <div id="forgot">
              <label > <input type="checkbox" id="chec">
                Remember me</label>
                <a href="#">Forgot Password?</a>
            </div>

            <div class="submit">
                <button type="submit" class="yes ">
                    Login
                </button>
            </div>
            <div class="register">
                <p>Don`t have an account? <a href="/signup">Register</a></p>
            </div>

        </form>

    </div>

</div>